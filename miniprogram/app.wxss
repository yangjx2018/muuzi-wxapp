page {
  --app-bg: #f4f5f8;
  --app-card: #ffffff;
  --app-ink: #15171e;
  --app-ink-2: #33374a;
  --app-muted: #666c80;
  --app-faint: #9ea3b4;
  --app-accent: #2f6df4;
  --app-accent-soft: #6a99fe;
  --app-accent-wash: #eaf1ff;
  --app-line: rgba(21, 23, 30, 0.08);
  --app-online: #57c98a;
  --app-grad: linear-gradient(160deg, #6a99fe, #2f6df4);
  background: var(--app-bg);
  color: var(--app-ink);
  font-size: 28rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei',
    sans-serif;
}

.auth-page {
  min-height: 100vh;
  background: var(--app-bg);
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶栏固定：结构对齐 app-banner（左内容 + 右侧胶囊占位） */
.auth-header-spacer {
  width: 100%;
  flex-shrink: 0;
}

.auth-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  background: var(--app-bg);
  border-bottom: 1rpx solid var(--app-line);
}

.auth-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 0 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.auth-header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.auth-header-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
}

/* 与胶囊同高的返回「<」 */
.auth-nav-back {
  width: 56rpx;
  height: 56rpx;
  margin-left: -6rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.auth-nav-back:active {
  opacity: 0.55;
}

.auth-nav-back-glyph {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 400;
  color: var(--app-ink);
}

.auth-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--app-grad);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.auth-mark-img {
  width: 100%;
  height: 100%;
  display: block;
}

.auth-wordmark {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.auth-wordmark-name {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.auth-wordmark-section {
  font-size: 17rpx;
  letter-spacing: 0.1em;
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1;
}

.auth-status {
  font-size: 17rpx;
  letter-spacing: 0.08em;
  color: var(--app-online);
  flex-shrink: 0;
  line-height: 1;
}

.auth-gear {
  width: 48rpx;
  height: 48rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: var(--app-muted);
}

.auth-gear:active {
  background: var(--app-accent-wash);
}

.auth-ico-gear {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}

.auth-ico-gear::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: currentColor;
}

.auth-body {
  padding: 44rpx 44rpx 0;
  display: flex;
  flex-direction: column;
}

.auth-back {
  align-self: flex-start;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--app-muted);
  margin-bottom: 40rpx;
}

.auth-step {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--app-accent);
  text-transform: uppercase;
  margin-bottom: 26rpx;
}

.auth-title {
  font-size: 64rpx;
  line-height: 1.14;
  font-weight: 600;
  margin-bottom: 28rpx;
  white-space: pre-line;
}

.auth-lead {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--app-muted);
  margin-bottom: 48rpx;
}

.auth-notice {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(87, 201, 138, 0.13);
  color: #2a7d51;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.auth-notice.error {
  background: rgba(255, 45, 85, 0.1);
  color: #c0173a;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 30rpx;
}

.field-label {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--app-muted);
}

.field-input {
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  color: var(--app-ink);
  font-size: 32rpx;
}

.field-secure {
  position: relative;
  display: flex;
  align-items: center;
}

.field-input-secure {
  flex: 1;
  padding-right: 120rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 密文外观：不用 password 属性，避免华为安全键盘；普通键盘 + CSS 圆点。
   仅当 input 已有内容时挂 .is-masked（见 auth wxml）；空框挂 disc 会冒出一个幽灵圆点。 */
.field-input-secure.is-masked {
  -webkit-text-security: disc;
  text-security: disc;
}

.field-reveal {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 16rpx;
  color: var(--app-accent);
}

.field-reveal:active {
  background: var(--app-accent-wash);
}

.field-reveal-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.field-input-placeholder {
  color: var(--app-faint);
}

.assist-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -12rpx;
  margin-bottom: 40rpx;
}

.assist-link {
  font-size: 24rpx;
  color: var(--app-accent);
}

.btn-primary {
  width: 100% !important;
  min-height: 108rpx;
  line-height: 108rpx;
  padding: 0 36rpx !important;
  margin: 0 !important;
  border-radius: 32rpx !important;
  background: var(--app-grad) !important;
  color: #ffffff !important;
  font-size: 23rpx !important;
  font-weight: 500 !important;
  letter-spacing: 0.1em;
  text-align: left !important;
  border: none !important;
  box-sizing: border-box;
}

.btn-primary[disabled],
.btn-primary.is-muted {
  opacity: 0.35;
}

/* native button leftover; hide hitbox completely */
button.btn-primary::after {
  border: none !important;
  content: none !important;
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
}

.divider {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 44rpx 0 32rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--app-line);
}

.divider-text {
  font-size: 18rpx;
  letter-spacing: 0.1em;
  color: var(--app-muted);
}

.btn-wechat {
  width: 100%;
  height: 104rpx;
  border-radius: 28rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-wechat[disabled] {
  opacity: 0.45;
}

.btn-wechat::after {
  border: none;
}

.footer-link {
  margin-top: 44rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 26rpx;
}

.footer-prompt {
  color: var(--app-muted);
}

.footer-action {
  color: var(--app-accent);
  display: inline-flex;
  align-items: center;
  padding: 8rpx 4rpx;
}

.footer-action:active {
  opacity: 0.65;
}

.legal-note {
  margin-top: 36rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--app-faint);
}

.status-strip {
  margin-top: 44rpx;
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  letter-spacing: 0.1em;
  color: var(--app-muted);
}

.node-selected {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  margin-bottom: 36rpx;
}

.node-identity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.node-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--app-accent-wash);
  color: var(--app-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.node-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.node-domain {
  display: block;
  font-size: 22rpx;
  color: var(--app-muted);
  margin-top: 4rpx;
}

.node-change {
  font-size: 22rpx;
  color: var(--app-accent);
  flex-shrink: 0;
  padding: 12rpx 8rpx;
}

.node-change:active {
  opacity: 0.65;
}

.node-picker {
  margin-bottom: 36rpx;
}

.node-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  margin-bottom: 16rpx;
}

.node-option.active {
  border-color: var(--app-accent);
  box-shadow: 0 0 0 6rpx var(--app-accent-wash);
}

.pwd-rule {
  font-size: 22rpx;
  color: var(--app-muted);
  margin-bottom: 24rpx;
}

.pwd-rule.met {
  color: #2a7d51;
}

.email-summary {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--app-accent-wash);
  color: var(--app-accent);
  font-size: 28rpx;
  margin-bottom: 36rpx;
}

.resend {
  font-size: 24rpx;
  color: var(--app-accent);
  margin-top: 16rpx;
}

.resend.disabled {
  color: var(--app-faint);
}

.btn-primary-hover { opacity: 0.88; }
