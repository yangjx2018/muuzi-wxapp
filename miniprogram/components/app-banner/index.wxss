/* 对齐 App AppBanner.module.css
 *
 * virtualHost 下去掉宿主节点后，root 不再挡住下层；
 * 再加 pointer-events 双保险（fixed 顶栏只自己接收点击）。
 */
.app-banner-root {
  position: relative;
  width: 100%;
  pointer-events: none;
}

.app-banner-spacer {
  width: 100%;
  flex-shrink: 0;
  pointer-events: none;
}

.app-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--app-bg, #f4f5f8);
  box-sizing: border-box;
  pointer-events: auto;
}

.app-banner-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 0 14rpx;
  box-sizing: border-box;
}

.app-banner-side {
  flex: 1;
  min-width: 68rpx;
  display: flex;
  align-items: center;
}

.app-banner-side-right {
  justify-content: flex-end;
  /* 右侧只占位避开胶囊，不抢点击 */
  pointer-events: none;
}

.app-banner-back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
  pointer-events: auto;
}

.app-banner-back-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.app-banner-identity {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  max-width: 58%;
}

.app-banner-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--app-grad, linear-gradient(160deg, #6a99fe, #2f6df4));
}

.app-banner-mark-img {
  width: 100%;
  height: 100%;
  display: block;
}

.app-banner-name {
  font-family: 'Songti SC', 'Noto Serif SC', Georgia, 'Times New Roman', serif;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--app-ink, #15171e);
  flex-shrink: 0;
}

.app-banner-section {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 17rpx;
  letter-spacing: 0.14em;
  color: var(--app-muted, #666c80);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}
