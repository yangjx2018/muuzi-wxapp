/* 对齐公开页 hero-profile / render-page.js */

.hpp {
  position: relative;
  margin: 0;
  padding: 0 0 24rpx;
  background: #fff;
  color: #20232b;
  min-height: 70vh;
}

.hpp-tools {
  position: absolute;
  top: 28rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hpp-brand,
.hpp-share {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(21, 23, 30, 0.08);
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 1;
  flex: none;
}

.hpp-tools-spacer,
.hpp-tools-mid {
  width: 60rpx;
  height: 60rpx;
  flex: none;
}

.hpp-tools-mid {
  flex: 1;
}

.hpp-draft-badge {
  flex: 1;
  text-align: center;
  align-self: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #15171e;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.hpp-brand-img,
.hpp-share-img {
  width: 34rpx;
  height: 34rpx;
  display: block;
  border-radius: 8rpx;
}

.hpp-share::after {
  border: none;
}

.hpp-share-hover {
  opacity: 0.85;
}

.hpp-cover {
  display: flex;
  gap: 16rpx;
  height: 504rpx;
  padding: 116rpx 36rpx 0;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.hpp-cover::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 160rpx;
  background: linear-gradient(
    transparent 10%,
    rgba(255, 255, 255, 0.6) 62%,
    #fff 100%
  );
  pointer-events: none;
}

.hpp-cover-img,
.hpp-cover-light {
  flex: 1;
  min-width: 0;
  height: 100%;
  border-radius: 48rpx 48rpx 0 0;
}

.hpp-cover-light-0 {
  background: linear-gradient(145deg, #dce8f7, #91b1b8);
}

.hpp-cover-light-1 {
  background: linear-gradient(150deg, #edf0d4, #a0b9ac);
}

.hpp-cover-light-2 {
  background: linear-gradient(145deg, #e3d9d2, #abc0de);
}

.hpp-hero {
  position: relative;
  z-index: 2;
  margin-top: -112rpx;
  padding: 0 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.hpp-avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 8rpx solid #fff;
  background: #eef2fb;
  box-sizing: border-box;
}

.hpp-avatar-img {
  width: 100%;
  height: 100%;
}

.hpp-portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 500;
  color: #316bfa;
  background: #eef2fb;
}

.hpp-name {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 500;
  color: #20232b;
  line-height: 1.25;
  letter-spacing: -1.4rpx;
}

.hpp-kicker {
  font-size: 26rpx;
  font-weight: 400;
  color: #69717b;
  line-height: 1.5;
  max-width: 620rpx;
}

.hpp-bio {
  font-size: 26rpx;
  font-weight: 400;
  color: #737982;
  line-height: 1.65;
  max-width: 620rpx;
}

.hpp-socials {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 0 8rpx;
}

.hpp-social {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f4f6fa;
  border: 2rpx solid #e9edf4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: none;
  overflow: hidden;
}

.hpp-social-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
  flex: none;
  margin: 0;
  padding: 0;
}

.hpp-meta {
  margin: 24rpx 36rpx 0;
  padding: 8rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hpp-meta-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hpp-meta-label,
.hpp-meta-heading {
  font-size: 28rpx;
  font-weight: 600;
  color: #20232b;
}

.hpp-meta-heading {
  margin-top: 12rpx;
}

.hpp-meta-text {
  font-size: 26rpx;
  color: #69717b;
  line-height: 1.5;
}

.hpp-meta-note {
  font-size: 22rpx;
  color: #8b929c;
}

.hpp-coop-card {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #f4f6fa;
  border: 1rpx solid #e9edf4;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hpp-coop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #20232b;
}

.hpp-coop-meta {
  font-size: 24rpx;
  color: #69717b;
}

.hpp-section {
  margin: 28rpx 36rpx 0;
  padding: 0;
}

.hpp-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 8rpx 16rpx;
}

.hpp-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #8b929c;
  line-height: 1.5;
}

.hpp-section-count {
  font-size: 22rpx;
  font-family: ui-monospace, monospace;
  color: #8b929c;
}

.hpp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hpp-tag {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f4f6fa;
  border: 1rpx solid #e9edf4;
  font-size: 24rpx;
  color: #333d51;
}

.hpp-tag-link {
  color: #316bfa;
}

.hpp-agent {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: none;
}

.hpp-agent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.hpp-agent-name {
  font-size: 40rpx;
  font-weight: 500;
  color: #20232b;
  line-height: 1.25;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", Georgia, serif;
  letter-spacing: -0.4rpx;
}

.hpp-agent-try {
  font-size: 20rpx;
  color: #316bfa;
  flex: none;
  white-space: nowrap;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  letter-spacing: 0.04em;
}

.hpp-agent-desc {
  font-size: 24rpx;
  color: #69717b;
  line-height: 1.5;
}

.hpp-film-hero {
  position: relative;
  border-radius: 36rpx;
  overflow: hidden;
  background: #eef2fb;
  aspect-ratio: 16 / 9;
  margin-bottom: 12rpx;
}

.hpp-film-hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hpp-film-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8b929c;
  letter-spacing: 0.12em;
}

.hpp-film-play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.hpp-film-play-dot {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #20232b;
  line-height: 100rpx;
  text-align: center;
}

.hpp-film-caption {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  max-width: calc(100% - 56rpx);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  color: #20232b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hpp-film-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.hpp-film-thumb {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #eef2fb;
  aspect-ratio: 4 / 3;
}

.hpp-film-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hpp-film-thumb-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 12rpx;
  font-size: 20rpx;
  color: #20232b;
  background: linear-gradient(to top, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hpp-shop-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.hpp-product {
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f4f6fa;
  border: 1rpx solid #e9edf4;
}

.hpp-product-img {
  height: 200rpx;
  background: #e9edf4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hpp-product-img-el {
  width: 100%;
  height: 100%;
}

.hpp-product-ph {
  font-size: 22rpx;
  color: #8b929c;
}

.hpp-product-body {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hpp-product-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #20232b;
}

.hpp-product-note {
  font-size: 22rpx;
  color: #69717b;
}

.hpp-product-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #20232b;
  margin-top: 4rpx;
}

.hpp-product-buy {
  color: #316bfa;
}

.hpp-audio-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  border-radius: 28rpx;
  background: #f4f6fa;
  border: 1rpx solid #e9edf4;
}

.hpp-audio-playing {
  border-color: #316bfa;
}

.hpp-audio-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #316bfa;
  flex: none;
}

.hpp-audio-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hpp-audio-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #20232b;
}

.hpp-audio-meta {
  font-size: 22rpx;
  color: #8b929c;
}

.hpp-note-card {
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid #e9edf4;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hpp-note-img {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.hpp-note-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #20232b;
}

.hpp-note-body {
  font-size: 26rpx;
  line-height: 1.55;
  color: #69717b;
}

.hpp-note-cta {
  font-size: 26rpx;
  color: #316bfa;
  font-weight: 500;
  margin-top: 4rpx;
}

.hpp-link-card {
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #e9edf4;
  box-shadow: 0 2rpx 10rpx rgba(32, 35, 43, 0.04);
  overflow: hidden;
}

.hpp-link-featured .hpp-link-hero-img {
  width: 100%;
  height: 280rpx;
  display: block;
}

.hpp-link-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.hpp-link-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  flex: none;
  background: #eef2fb;
}

.hpp-link-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hpp-link-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #20232b;
  line-height: 1.35;
}

.hpp-link-note {
  font-size: 24rpx;
  color: #8b929c;
  line-height: 1.4;
}

.hpp-link-arrow {
  flex: none;
  font-size: 28rpx;
  color: #316bfa;
}

/* —— carousel：对齐 .collection-carousel · flex 横滑 · 单卡 82% —— */
.hpp-carousel {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.hpp-carousel-track {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 24rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.hpp-carousel-card {
  flex: 0 0 82%;
  width: 82%;
  max-width: 82%;
  min-width: 0;
  border-radius: 40rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-shadow: 0 4rpx 16rpx rgba(32, 35, 43, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.hpp-carousel-media {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: rgba(21, 23, 30, 0.06);
  flex: none;
}

.hpp-carousel-body {
  position: relative;
  padding: 28rpx 56rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.hpp-carousel-arrow {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 28rpx;
  line-height: 1;
}

/* —— showcase / grid bento：对齐 .collection-showcase —— */
.hpp-bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  min-width: 0;
}

.hpp-bento-card {
  min-width: 0;
  border-radius: 40rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-shadow: 0 4rpx 16rpx rgba(32, 35, 43, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

/* showcase 首卡通栏 · grid-column: 1 / -1 */
.hpp-bento-showcase .hpp-bento-hero {
  grid-column: 1 / -1;
}

.hpp-bento-media {
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: rgba(21, 23, 30, 0.06);
  flex: none;
}

.hpp-bento-media-hero {
  aspect-ratio: 16 / 9;
}

.hpp-bento-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hpp-bento-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #e9edf4, #dce3ee);
}

.hpp-bento-body {
  padding: 28rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.hpp-bento-showcase .hpp-bento-hero .hpp-bento-body {
  padding: 32rpx 36rpx 36rpx;
}

.hpp-bento-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #20232b;
}

.hpp-bento-showcase .hpp-bento-hero .hpp-bento-title {
  font-size: 34rpx;
  letter-spacing: -0.4rpx;
}

.hpp-bento-note {
  font-size: 22rpx;
  line-height: 1.45;
  color: #69717b;
}

.hpp-bento-showcase .hpp-bento-hero .hpp-bento-note {
  font-size: 24rpx;
}

.hpp-footer {
  margin: 60rpx 40rpx 0;
  padding: 40rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
  text-align: center;
  border: 0;
}

.hpp-join {
  font-size: 24rpx;
  font-weight: 500;
  color: #316bfa;
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  border: none;
  background: #f2f5fc;
  line-height: 1.4;
}

.hpp-legal,
.hpp-more {
  font-size: 20rpx;
  color: #7c8490;
  line-height: 1.6;
}

.hpp-legal-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  text-align: center;
}

.hpp-more {
  display: block;
}

/* 对齐公开页 .home-entry / .home-login · 图2「登录 MuuZi →」 */
.hpp-home-entry {
  display: flex;
  justify-content: center;
  padding: 0 44rpx 56rpx;
  margin: 0;
  flex: none;
}

.hpp-home-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  min-height: 88rpx;
  max-width: 100%;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dce5f5;
  background: #f2f5fc;
  box-sizing: border-box;
}

.hpp-home-login-text,
.hpp-home-login-arrow {
  font-size: 24rpx;
  font-weight: 500;
  color: #316bfa;
  line-height: 1.5;
}

.hpp-home-login-arrow {
  font-size: 28rpx;
  line-height: 1;
}
