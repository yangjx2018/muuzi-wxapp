<view class="auth-page">
  <view class="auth-header">
    <view class="auth-mark">
      <image class="auth-mark-img" src="/assets/logo-muu.png" mode="aspectFit" />
    </view>
    <view class="auth-wordmark">
      <text class="auth-wordmark-name">MuuZi</text>
      <text class="auth-wordmark-section">// 确认账号</text>
    </view>
    <text class="auth-status">WECHAT / OK</text>
  </view>

  <view class="auth-body">
    <view class="progress">
      <text class="progress-done">① 微信已验证</text>
      <text class="progress-sep">·</text>
      <text class="progress-now">② 确认账号</text>
    </view>

    <block wx:if="{{!failMode}}">
      <view class="auth-title">验证并绑定</view>
      <view class="auth-lead">输入本节点已有账号完成验证。通过后进入小程序，之后同一微信可一键登录。</view>

      <view class="bind-card">
        <view class="bind-card-row">
          <text class="bind-card-k">节点</text>
          <text class="bind-card-v">{{nodeLabel}}</text>
        </view>
        <view class="bind-card-row">
          <text class="bind-card-k">有效期</text>
          <text class="bind-card-v">{{expiresHint}}</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">账号或邮箱</text>
        <input class="field-input" placeholder="本节点已有账号" placeholder-class="field-input-placeholder" value="{{identifier}}" bindinput="onIdentifier" />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <view class="field-secure">
          <input class="field-input field-input-secure" password="{{!showPassword}}" value="{{password}}" bindinput="onPassword" />
          <view class="field-reveal" bindtap="togglePassword" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}"><text class="field-reveal-text">{{showPassword ? '隐藏' : '显示'}}</text></view>
        </view>
      </view>

      <button class="btn-primary" disabled="{{!ready}}" bindtap="onSubmit">
        <text>{{busy ? '正在验证…' : '验证并绑定'}}</text><text>→</text>
      </button>
      <view wx:if="{{error}}" class="auth-notice error" style="margin-top:28rpx">{{error}}</view>
    </block>

    <block wx:else>
      <view class="auth-title">账号验证未通过</view>
      <view class="auth-lead">{{error}}。可重新填写账号，或建立新账号后再绑定。</view>
      <button class="btn-primary" bindtap="onRetry"><text>重新填写账号</text><text>→</text></button>
      <button class="btn-wechat" style="margin-top:20rpx;background:#fff;color:#15171e;border:2rpx solid rgba(21,23,30,0.08)" bindtap="goCreateAccount">建立新账号</button>
    </block>

    <view class="footer-link" style="margin-top:36rpx">
      <text class="footer-prompt">想换个微信？</text>
      <text class="footer-action" bindtap="goReloginWeChat">重新微信登录</text>
    </view>
    <view class="legal-note">微信登录码与账号密码只会送往当前节点，不会送往 Nexus。</view>
  </view>
</view>
