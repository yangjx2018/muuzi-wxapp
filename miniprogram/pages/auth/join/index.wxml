<view class="auth-page">
  <app-banner
    section="建立账号"
    show-back
    auto-back="{{false}}"
    bind:back="goLogin"
  />
  <view class="auth-body">
    <view class="auth-step">AUTH.REGISTER / 01</view>
    <view class="auth-title">建立你的\nMuuZi ID</view>
    <view class="auth-lead">我们会先验证这个邮箱，再建立你的账号、主页与分身 Muu 的身份。</view>

    <block wx:if="{{node && !picking}}">
      <view class="node-selected">
        <view class="node-identity">
          <view class="node-logo">{{nodeInitial}}</view>
          <view>
            <text class="node-name">{{node.brandName}}</text>
            <text class="node-domain">{{node.domain}}</text>
          </view>
        </view>
        <view class="node-change" catchtap="onChangeNode" hover-class="none">更换节点</view>
      </view>
    </block>
    <view wx:else class="node-picker">
      <view wx:for="{{nodes}}" wx:key="domain" class="node-option" data-domain="{{item.domain}}" bindtap="onPickNode">
        <text class="node-name">{{item.company_name || item.label}}</text>
        <text class="node-domain">{{item.domain}}</text>
      </view>
    </view>

    <view class="field">
      <text class="field-label">注册邮箱</text>
      <input class="field-input" type="text" placeholder="you@example.com" placeholder-class="field-input-placeholder" value="{{email}}" bindinput="onEmail" />
    </view>
    <button class="btn-primary" disabled="{{!ready}}" bindtap="onSubmit">
      <text>寄送验证码</text><text>→</text>
    </button>
    <view wx:if="{{error}}" class="auth-notice error" style="margin-top:28rpx">{{error}}</view>
    <view class="footer-link">
      <text class="footer-prompt">已经有 MuuZi ID？</text>
      <view class="footer-action" catchtap="goLogin" hover-class="none">直接登录</view>
    </view>
    <view class="footer-link">
      <text class="footer-prompt">已有账号但忘了密码？</text>
      <view class="footer-action" catchtap="goRecover" hover-class="none">找回密码</view>
    </view>
    <view class="legal-note">个人身份在 MuuZi 中称为主理人。建立账号即表示你同意 MuuZi 的服务条款与隐私政策。</view>
    <view class="status-strip"><text>STEP 1 / 3</text><text></text></view>
  </view>
</view>
