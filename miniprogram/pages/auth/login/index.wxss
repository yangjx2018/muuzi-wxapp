/* 登录页：首次微信绑定弹层 */
.bind-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bind-mask-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 23, 30, 0.48);
}

.bind-sheet {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 48rpx rgba(21, 23, 30, 0.12);
}

.bind-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(21, 23, 30, 0.12);
  margin: 0 auto 28rpx;
}

.bind-sheet-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--app-ink);
  margin-bottom: 12rpx;
}

.bind-sheet-lead {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--app-muted);
  margin-bottom: 32rpx;
}

.bind-sheet-secondary {
  margin-top: 20rpx;
  background: #ffffff !important;
  color: var(--app-ink) !important;
  border: 2rpx solid var(--app-line) !important;
}

.bind-sheet-cancel {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-muted);
  padding: 16rpx;
}
