<view class="auth-page">
  <app-banner
    section="账号找回"
    show-back
    auto-back="{{false}}"
    bind:back="goLogin"
  />
  <view class="auth-body">
    <view class="auth-step">AUTH.RECOVERY / 01</view>
    <view class="auth-title">重设你的\n密码</view>
    <view class="auth-lead">输入 MuuZi ID 绑定的邮箱。我们会寄送 6 位数验证码，通过后才能建立新密码。</view>
    <view class="legal-note" style="margin-top:0;margin-bottom:36rpx">请选择注册账号时的节点。未绑定邮箱的账号，请联系该节点管理员协助恢复。</view>

    <block wx:if="{{node && !picking}}">
      <view class="node-selected">
        <view class="node-identity">
          <view class="node-logo">{{nodeInitial}}</view>
          <view>
            <text class="node-name">{{node.brandName}}</text>
            <text class="node-domain">{{node.domain}}</text>
          </view>
        </view>
        <view class="node-change" catchtap="onChangeNode" hover-class="none">更换节点</view>
      </view>
    </block>
    <view wx:else class="node-picker">
      <view wx:for="{{nodes}}" wx:key="domain" class="node-option" data-domain="{{item.domain}}" bindtap="onPickNode">
        <text class="node-name">{{item.company_name || item.label}}</text>
        <text class="node-domain">{{item.domain}}</text>
      </view>
    </view>

    <view class="field">
      <text class="field-label">账号邮箱</text>
      <input class="field-input" value="{{email}}" placeholder="you@example.com" placeholder-class="field-input-placeholder" bindinput="onEmail" />
    </view>
    <button class="btn-primary" disabled="{{!ready}}" bindtap="onSubmit"><text>寄送验证码</text><text>→</text></button>
    <view wx:if="{{error}}" class="auth-notice error" style="margin-top:28rpx">{{error}}</view>
    <view class="footer-link">
      <text class="footer-prompt">想起来了？</text>
      <view class="footer-action" catchtap="goLogin" hover-class="none">回去登录</view>
    </view>
    <view class="legal-note">为了保护账号，无论这个邮箱是否已注册，页面都会走到下一步。</view>
    <view class="status-strip"><text>STEP 1 / 3</text><text></text></view>
  </view>
</view>
