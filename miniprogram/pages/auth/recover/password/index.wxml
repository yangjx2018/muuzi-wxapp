<view class="auth-page">
  <app-banner
    section="账号找回"
    show-back
    auto-back="{{false}}"
    bind:back="goBack"
  />
  <view class="auth-body">
    <view class="auth-step">AUTH.RECOVERY / 03</view>
    <view class="auth-title">建立新的\n密码</view>
    <view class="auth-lead">设定新密码后，其他设备上的登录状态会一并失效。</view>
    <view class="field">
      <text class="field-label">新密码</text>
              <view class="field-secure">
          <input
            class="field-input field-input-secure {{!showPassword && password ? 'is-masked' : ''}}"
            type="text"
            placeholder="请输入新密码"
            placeholder-class="field-input-placeholder"
            value="{{password}}"
            hold-keyboard="{{true}}"
            always-embed="{{true}}"
            adjust-position="{{true}}"
            cursor-spacing="48"
            bindinput="onPassword"
          />
          <view
            class="field-reveal"
            catchtap="togglePassword"
            aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}"
          >
            <image
              class="field-reveal-icon"
              src="{{showPassword ? '/assets/icon-ui-eye-open.svg' : '/assets/icon-ui-eye-closed.svg'}}"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
        </view>
    </view>
    <view class="field">
      <text class="field-label">确认新密码</text>
              <view class="field-secure">
          <input
            class="field-input field-input-secure {{!showConfirm && confirmation ? 'is-masked' : ''}}"
            type="text"
            placeholder="请再次输入新密码"
            placeholder-class="field-input-placeholder"
            value="{{confirmation}}"
            hold-keyboard="{{true}}"
            always-embed="{{true}}"
            adjust-position="{{true}}"
            cursor-spacing="48"
            bindinput="onConfirm"
          />
          <view
            class="field-reveal"
            catchtap="toggleConfirm"
            aria-label="{{showConfirm ? '隐藏密码' : '显示密码'}}"
          >
            <image
              class="field-reveal-icon"
              src="{{showConfirm ? '/assets/icon-ui-eye-open.svg' : '/assets/icon-ui-eye-closed.svg'}}"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
        </view>
    </view>
    <view class="pwd-rule {{strong ? 'met' : ''}}">8–512 个字符，字母、数字、符号至少两类</view>
    <view class="pwd-rule {{matches ? 'met' : ''}}">两次密码一致</view>
    <button class="btn-primary" disabled="{{!ready}}" bindtap="onSubmit"><text>更新密码</text><text>→</text></button>
    <view wx:if="{{error}}" class="auth-notice error" style="margin-top:28rpx">{{error}}</view>
    <view class="status-strip"><text>STEP 3 / 3</text><text></text></view>
  </view>
</view>
