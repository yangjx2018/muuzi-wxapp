<view class="auth-page">
  <app-banner
    section="账号找回"
    show-back
    auto-back="{{false}}"
    bind:back="goBack"
  />
  <view class="auth-body">
    <view class="auth-step">AUTH.RECOVERY / 02</view>
    <view class="auth-title">输入邮箱\n验证码</view>
    <view class="auth-lead">请输入寄至下方邮箱的 6 位数验证码。</view>
    <view class="email-summary">{{email}}</view>
    <view class="field">
      <text class="field-label">验证码</text>
      <input class="field-input" type="digit" maxlength="6" placeholder="······" placeholder-class="field-input-placeholder" value="{{code}}" bindinput="onCode" />
    </view>
    <button class="btn-primary" disabled="{{!ready}}" bindtap="onSubmit"><text>继续</text><text>→</text></button>
    <text wx:if="{{left > 0}}" class="resend disabled">重新寄送（{{left}}s）</text>
    <text wx:else class="resend" bindtap="onResend">重新寄送</text>
    <view wx:if="{{error}}" class="auth-notice error" style="margin-top:28rpx">{{error}}</view>
    <view class="status-strip"><text>STEP 2 / 3</text><text></text></view>
  </view>
</view>
