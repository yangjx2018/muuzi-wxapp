@import "../index.wxss";

.fc-join {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.fc-card-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.fc-label {
  display: block;
  font-size: 22rpx;
  color: var(--app-muted);
  margin-bottom: 12rpx;
}

.fc-picker {
  min-width: 200rpx;
  padding: 16rpx 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--app-ink);
}

.fc-availability {
  font-size: 24rpx;
  color: var(--app-muted);
  line-height: 1.6;
  margin: 16rpx 0;
}

.fc-join-secondary {
  margin-top: 20rpx;
  opacity: 0.55;
}

.fc-paste-block {
  margin: 28rpx 0 20rpx;
}

.fc-textarea {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--app-bg);
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--app-ink);
  margin-bottom: 16rpx;
}

.fc-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--app-bg);
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.fc-topic-form {
  margin: 20rpx 0;
}

.fc-consent {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--app-ink-2);
  line-height: 1.5;
  margin: 16rpx 0 24rpx;
}

.fc-talk-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 12rpx 0 16rpx;
  color: var(--app-ink);
}

.fc-messages {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.fc-message {
  padding: 20rpx 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  border-radius: 24rpx;
  max-width: 92%;
}

.fc-message-own {
  align-self: flex-end;
  background: var(--app-accent-wash);
  border-color: transparent;
}

.fc-message-meta {
  font-size: 20rpx;
  color: var(--app-muted);
  margin-bottom: 8rpx;
}

.fc-message-text {
  font-size: 28rpx;
  color: var(--app-ink);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

.fc-card-refresh {
  margin: 8rpx 0 16rpx;
  padding: 20rpx 0;
  background: transparent;
  color: var(--app-accent);
  font-size: 26rpx;
  border: none;
  text-align: left;
}

.fc-card-refresh::after {
  border: none;
}

.fc-card-refresh[disabled] {
  opacity: 0.5;
}

.fc-link-btn {
  margin: 8rpx 0;
  padding: 0;
  background: transparent;
  color: var(--app-accent);
  font-size: 26rpx;
  border: none;
  text-align: left;
  display: inline-block;
  width: auto;
  line-height: 1.5;
}

.fc-link-btn::after {
  border: none;
}

.fc-join-footer {
  margin-top: 32rpx;
}

.fc-primary {
  margin-top: 8rpx;
  background: var(--app-grad);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
}

.fc-primary::after {
  border: none;
}

.fc-primary[disabled] {
  opacity: 0.45;
}
