/**
 * 共享「我」子页壳样式 · 对齐 edit-home / settings 视觉语言
 */
.mp {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 8rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
}

.mp-header {
  display: grid;
  grid-template-columns: 120rpx 1fr 120rpx;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.mp-back {
  color: var(--app-accent);
  font-size: 28rpx;
}

.mp-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.mp-lead {
  margin: 0 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--app-muted);
  line-height: 1.55;
}

.mp-card {
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  border-radius: 32rpx;
  padding: 8rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.mp-h2 {
  margin: 20rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.mp-field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--app-line);
}

.mp-field:last-child {
  border-bottom: none;
}

.mp-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.mp-input,
.mp-textarea {
  width: 100%;
  min-height: 48rpx;
  font-size: 28rpx;
  color: var(--app-ink);
  background: transparent;
}

.mp-textarea {
  min-height: 120rpx;
  line-height: 1.45;
}

.mp-row {
  display: flex;
  gap: 20rpx;
}

.mp-row .mp-field {
  flex: 1;
}

.mp-btn {
  margin: 8rpx 0 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.mp-btn::after {
  border: none;
}

.mp-btn-primary {
  background: var(--app-grad);
  color: #fff;
}

.mp-btn-primary[disabled] {
  opacity: 0.55;
}

.mp-btn-ghost {
  background: transparent;
  color: var(--app-accent);
  font-size: 26rpx;
  line-height: 2;
}

.mp-btn-secondary {
  background: var(--app-card);
  color: var(--app-ink);
  border: 1rpx solid var(--app-line);
}

.mp-error {
  margin: 8rpx 0 16rpx;
  color: #c45b5b;
  font-size: 24rpx;
  line-height: 1.45;
}

.mp-note {
  margin: 8rpx 0 16rpx;
  color: var(--app-ink-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.mp-state {
  margin-top: 64rpx;
  text-align: center;
  color: var(--app-muted);
  line-height: 1.5;
}

.mp-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--app-line);
}

.mp-item-meta {
  font-size: 22rpx;
  color: var(--app-muted);
  margin-bottom: 8rpx;
}

.mp-item-body {
  font-size: 28rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.mp-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.mp-link {
  color: var(--app-accent);
  font-size: 26rpx;
}

.mp-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
}

.mp-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
  background: var(--app-card);
  border-radius: 999rpx;
  padding: 6rpx;
  border: 1rpx solid var(--app-line);
}

.mp-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--app-muted);
}

.mp-tab-on {
  background: var(--app-accent-wash);
  color: var(--app-ink);
  font-weight: 600;
}
