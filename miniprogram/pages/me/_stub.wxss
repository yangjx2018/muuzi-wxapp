.me-stub {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
}

.me-stub-back {
  color: var(--app-accent);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.me-stub-kicker {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--app-muted);
}

.me-stub-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--app-ink);
}

.me-stub-lead {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--app-muted);
  line-height: 1.7;
}
