<app-banner
  wx:if="{{!linksOnly}}"
  section="{{isOrg ? '编辑企业主页' : '编辑主页'}}"
  show-back
  auto-back="{{false}}"
  bind:back="goBack"
  fallback-url="{{bannerFallbackUrl}}"
  fallback-tab="{{!isOrg}}"
/>
<view class="eh {{linksOnly ? 'eh-links-mode' : ''}}">
  <!-- linksOnly：对齐 App linksHeader · 主页内容（fixed，不随页滚） -->
  <view
    wx:if="{{linksOnly}}"
    class="eh-links-nav-wrap"
    style="padding-top: {{navPadTop}}px;"
  >
    <view class="eh-links-nav" style="height: {{navHeight}}px;">
      <view class="eh-links-nav-inner" style="height: {{navHeight}}px;">
        <view class="eh-links-header-btn" bindtap="goBack" aria-label="返回">
          <image
            class="eh-share-img"
            src="/assets/icon-ui-back-ink.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <text class="eh-links-title">主页内容</text>
        <view
          class="eh-links-header-btn"
          bindtap="openLinksShare"
          aria-label="分享主页"
          style="margin-right: {{sharePadRight}}px;"
        >
          <image
            class="eh-share-img"
            src="/assets/icon-ui-share-ink.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>
    </view>
  </view>
  <view
    wx:if="{{linksOnly}}"
    class="eh-links-nav-spacer"
    style="height: {{navTotalHeight}}px;"
  />

  <view wx:if="{{phase === 'connecting'}}" class="eh-state" role="status">正在连接平台…</view>

  <view wx:elif="{{phase === 'error'}}" class="eh-state" role="alert">
    <text>{{error}}</text>
    <button class="eh-btn eh-btn-secondary" bindtap="bootstrap">重试</button>
  </view>

  <view wx:elif="{{phase === 'slug'}}" class="eh-slug">
    <view class="eh-kicker">先选定主页地址</view>
    <view class="eh-lead">地址确认后即可编辑并发布。公开页与 App / Studio 共用同一份草稿。</view>
    <view class="eh-field">
      <text class="eh-label">主页短码</text>
      <input
        class="eh-input"
        value="{{slugInput}}"
        maxlength="40"
        placeholder="your-name"
        bindinput="onSlugInput"
      />
    </view>
    <view wx:if="{{error}}" class="eh-error" role="alert">{{error}}</view>
    <button class="eh-btn eh-btn-primary" bindtap="submitSlug" disabled="{{busy}}">
      {{busy ? '注册中…' : '确认地址'}}
    </button>
  </view>

  <!-- ========== linksOnly：主页内容编辑壳（对齐 App） ========== -->
  <block wx:elif="{{phase === 'editing' && linksOnly}}">
    <view class="eh-links-identity">
      <view class="eh-links-bio" bindtap="toggleLinksProfile">
        <text class="eh-links-name">{{draft.display_name || slug || '我的主页'}}</text>
        <text class="eh-links-sub">{{draft.headline || draft.bio || '添加简介'}}</text>
      </view>
      <view class="eh-links-avatar" bindtap="toggleLinksProfile" aria-label="编辑个人资料">
        <image
          wx:if="{{draft.portrait_url}}"
          class="eh-links-avatar-img"
          src="{{draft.portrait_url}}"
          mode="aspectFill"
        />
        <view wx:else class="eh-links-avatar-img eh-portrait-fallback">{{portraitLetter}}</view>
      </view>
      <view class="eh-social-row" aria-label="社交链接">
        <view
          wx:for="{{socialShortcuts}}"
          wx:key="kind"
          class="eh-social-chip {{item.configured ? 'eh-social-on' : ''}} eh-social-{{item.iconKind}}"
          data-kind="{{item.kind}}"
          bindtap="editSocialShortcut"
        >
          <view class="eh-social-icon-wrap">
            <image
              class="eh-social-icon"
              src="{{item.iconSrc}}"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
          <text wx:if="{{!item.configured}}" class="eh-social-plus">+</text>
        </view>
        <view class="eh-social-chip eh-social-add" bindtap="addSocialShortcut" aria-label="添加社交链接">
          <image
            class="eh-social-icon"
            src="/assets/social-plus.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{linksPanel === 'profile'}}" class="eh-links-panel">
      <view class="eh-section-label">PROFILE · 资料</view>
      <view class="eh-portrait-block">
        <view class="eh-portrait-ring" bindtap="pickPortrait" aria-label="更换头像">
          <image
            wx:if="{{draft.portrait_url}}"
            class="eh-portrait"
            src="{{draft.portrait_url}}"
            mode="aspectFill"
          />
          <view wx:else class="eh-portrait eh-portrait-fallback">{{portraitLetter}}</view>
          <view class="eh-portrait-badge">{{uploadBusy ? '…' : '换'}}</view>
        </view>
        <view class="eh-portrait-meta">
          <text class="eh-portrait-title">头像与基本资料</text>
          <text class="eh-portrait-hint">上传后写入公开主页草稿。</text>
        </view>
      </view>
      <view class="eh-card">
        <view class="eh-field">
          <text class="eh-label">昵称（1–40 字）</text>
          <input
            class="eh-input"
            value="{{draft.display_name}}"
            maxlength="40"
            placeholder="怎么称呼你"
            bindinput="onNameInput"
          />
        </view>
        <view class="eh-field">
          <text class="eh-label">一句话介绍</text>
          <input
            class="eh-input"
            value="{{draft.headline}}"
            maxlength="80"
            placeholder="你在做什么"
            bindinput="onHeadlineInput"
          />
        </view>
        <view class="eh-field eh-field-last">
          <text class="eh-label">简介</text>
          <textarea
            class="eh-textarea"
            value="{{draft.bio}}"
            maxlength="500"
            placeholder="让大家多了解一点你"
            auto-height
            bindinput="onBioInput"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{linksPanel === 'design'}}" class="eh-links-panel">
      <view class="eh-section-label">主页封面</view>
      <view class="eh-cover-box" bindtap="pickCover">
        <image
          wx:if="{{draft.cover_url}}"
          class="eh-cover-img"
          src="{{draft.cover_url}}"
          mode="aspectFill"
          style="object-position: center {{draft.cover_position || 50}}%;"
        />
        <text wx:else class="eh-cover-ph">添加一张代表你的封面</text>
      </view>
      <view class="eh-cover-actions">
        <button class="eh-btn eh-btn-ghost eh-btn-inline" bindtap="pickCover" disabled="{{busy}}">
          {{draft.cover_url ? '更换封面' : '上传封面'}}
        </button>
        <button
          wx:if="{{draft.cover_url}}"
          class="eh-btn eh-btn-ghost eh-btn-inline"
          bindtap="removeCover"
          disabled="{{busy}}"
        >移除封面</button>
      </view>
      <view wx:if="{{draft.cover_url}}" class="eh-field">
        <text class="eh-label">上下取景</text>
        <slider
          min="0"
          max="100"
          value="{{draft.cover_position || 50}}"
          activeColor="#2f6df4"
          block-size="20"
          bindchanging="onCoverPosition"
          bindchange="onCoverPosition"
        />
      </view>
      <view class="eh-section-label">主页配色</view>
      <view class="eh-skins">
        <view
          wx:for="{{skinOptions}}"
          wx:key="id"
          class="eh-skin {{item.selected ? 'eh-skin-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="pickSkin"
        >
          <view class="eh-skin-dot" style="background: {{item.swatch}}"></view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="eh-links-actions">
      <button class="eh-btn eh-btn-primary eh-add-content" bindtap="openAddContent" disabled="{{busy}}">
        ＋ 添加内容
      </button>
      <view class="eh-links-actions-row">
        <button class="eh-btn eh-btn-secondary eh-btn-inline" bindtap="addCollection" disabled="{{busy}}">
          ▤ 添加合集
        </button>
        <text class="eh-links-count">{{draft.sections.length}} / 8 · {{statusCopy}}</text>
      </view>
    </view>

    <view wx:if="{{saveError}}" class="eh-error eh-links-error" role="alert">{{saveError}}</view>

    <view class="eh-section-label">主页内容</view>

    <view
      wx:if="{{!draft.topLevelSectionCount}}"
      class="eh-links-empty"
    >
      <view class="eh-links-empty-icon" aria-hidden="true">
        <image class="eh-links-empty-img" src="/assets/icon-link.png" mode="aspectFit" />
      </view>
      <text class="eh-links-empty-title">让世界认识你</text>
      <text class="eh-links-empty-desc">添加第一个链接，让你的主页从这里开始。</text>
    </view>

    <block wx:for="{{draft.sections}}" wx:key="id" wx:for-item="section" wx:for-index="sIndex">
      <!-- 合集摘要 · 对齐 MobileCollectionSummary -->
      <view
        wx:if="{{!section.isCollectionChild && section.isLinkCollection}}"
        class="eh-col-summary {{section.visible === false ? 'eh-card-off' : ''}}"
      >
        <view class="eh-col-summary-head">
          <view class="eh-scc-handle" aria-label="拖动卡片排序" aria-hidden="true">
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
          </view>
          <view
            class="eh-col-summary-title"
            data-id="{{section.id}}"
            bindtap="openCollection"
          >
            <text class="eh-col-summary-name">{{section.title || '添加合集标题'}}</text>
            <text class="eh-col-summary-meta">{{section.memberCount}} 张内容卡片{{section.visible === false ? ' · 已隐藏' : ''}}</text>
          </view>
          <switch
            checked="{{section.visible !== false}}"
            color="#2f6df4"
            data-sindex="{{sIndex}}"
            bindchange="toggleSectionVisible"
          />
        </view>
        <view
          class="eh-col-prompt"
          data-id="{{section.id}}"
          bindtap="openCollection"
        >
          <view class="eh-col-prompt-icon" aria-hidden="true">
            <view class="eh-col-prompt-grid">
              <view class="eh-col-prompt-cell"></view>
              <view class="eh-col-prompt-cell"></view>
              <view class="eh-col-prompt-cell"></view>
              <view class="eh-col-prompt-cell"></view>
            </view>
          </view>
          <text>{{section.memberCount ? '管理合集内容与布局' : '点此向合集添加内容'}}</text>
          <text class="eh-col-prompt-chevron">›</text>
        </view>
      </view>

      <!-- 普通区块 / 单卡 · 对齐 StudioContentCard compact + StudioCardTools -->
      <view
        wx:elif="{{!section.isCollectionChild}}"
        class="eh-scc {{section.visible === false ? 'eh-card-off' : ''}}"
      >
        <view class="eh-scc-head">
          <view class="eh-scc-handle" aria-label="拖动卡片排序" aria-hidden="true">
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
            <view class="eh-scc-handle-dot"></view>
          </view>
          <text class="eh-scc-type">{{section.typeLabel}}</text>
          <input
            class="eh-scc-section-title"
            value="{{section.title}}"
            placeholder="区块标题"
            maxlength="40"
            data-sindex="{{sIndex}}"
            bindinput="onSectionTitle"
          />
          <view class="eh-scc-tools">
            <view
              class="eh-scc-move"
              data-sindex="{{sIndex}}"
              data-delta="-1"
              bindtap="moveSection"
              aria-label="上移区块"
            >↑</view>
            <view
              class="eh-scc-move"
              data-sindex="{{sIndex}}"
              data-delta="1"
              bindtap="moveSection"
              aria-label="下移区块"
            >↓</view>
            <switch
              checked="{{section.visible !== false}}"
              color="#2f6df4"
              data-sindex="{{sIndex}}"
              bindchange="toggleSectionVisible"
            />
          </view>
        </view>

        <block
          wx:for="{{section.items}}"
          wx:key="expandKey"
          wx:for-item="item"
          wx:for-index="iIndex"
        >
          <view class="eh-scc-card {{item.isSocialCard ? 'eh-scc-social' : ''}}">
            <view class="eh-scc-title-row">
              <input
                class="eh-scc-title"
                value="{{item.titleValue}}"
                placeholder="添加标题"
                maxlength="60"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-key="{{item.titleKey}}"
                bindinput="onItemField"
              />
              <view
                class="eh-scc-expand"
                data-key="{{item.expandKey}}"
                bindtap="toggleItemExpand"
                aria-label="{{item.expanded ? '收起内容设置' : '展开内容设置'}}"
              >{{item.expanded ? '⌃' : '⌄'}}</view>
            </view>
            <input
              wx:if="{{section.type !== 'skills'}}"
              class="eh-scc-url"
              value="{{item.url}}"
              placeholder="添加 URL"
              data-sindex="{{sIndex}}"
              data-iindex="{{iIndex}}"
              data-key="url"
              bindinput="onItemField"
            />

            <!-- StudioCardTools 八格工具条 · SVG 路径对齐 App StudioCardTools.tsx -->
            <view wx:if="{{section.type !== 'skills'}}" class="eh-scc-toolbar" aria-label="卡片工具">
              <view
                class="eh-scc-tool eh-scc-tool-settings {{item.toolBrand ? 'eh-scc-brand-' + item.toolBrand : ''}} {{item.expanded && !item.activeTool ? 'eh-scc-tool-on' : ''}}"
                data-tool="settings"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                data-brand="{{item.toolBrand}}"
                bindtap="onCardTool"
                aria-label="链接设置"
              >
                <image class="eh-scc-brand" src="{{item.toolBrandSrc}}" mode="aspectFit" />
              </view>
              <view
                class="eh-scc-tool {{item.activeTool === 'thumbnail' ? 'eh-scc-tool-on' : ''}} {{item.imageUrl && item.activeTool !== 'thumbnail' ? 'eh-scc-tool-thumb' : ''}}"
                data-tool="thumbnail"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-imagekey="{{item.imageKey}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="缩略图设置"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-thumbnail.svg" mode="aspectFit" aria-hidden="true" />
              </view>
              <view
                class="eh-scc-tool {{item.activeTool === 'highlight' ? 'eh-scc-tool-on' : ''}}"
                data-tool="highlight"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="重点展示"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-highlight.svg" mode="aspectFit" aria-hidden="true" />
              </view>
              <view
                class="eh-scc-tool {{item.activeTool === 'rules' ? 'eh-scc-tool-on' : ''}}"
                data-tool="rules"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="显示规则"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-rules.svg" mode="aspectFit" aria-hidden="true" />
              </view>
              <view
                class="eh-scc-tool {{item.activeTool === 'schedule' ? 'eh-scc-tool-on' : ''}}"
                data-tool="schedule"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="定时展示"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-schedule.svg" mode="aspectFit" aria-hidden="true" />
              </view>
              <view
                class="eh-scc-tool {{item.activeTool === 'access' ? 'eh-scc-tool-on' : ''}}"
                data-tool="access"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="访问限制"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-access.svg" mode="aspectFit" aria-hidden="true" />
              </view>
              <view
                class="eh-scc-tool eh-scc-tool-stats {{item.activeTool === 'stats' ? 'eh-scc-tool-on' : ''}}"
                data-tool="stats"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="点击统计"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-stats.svg" mode="aspectFit" aria-hidden="true" />
                <text>统计</text>
              </view>
              <view
                class="eh-scc-tool"
                data-tool="copy"
                data-key="{{item.expandKey}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-url="{{item.url}}"
                bindtap="onCardTool"
                aria-label="复制链接"
              >
                <image class="eh-scc-tool-ico" src="/assets/tool-copy.svg" mode="aspectFit" aria-hidden="true" />
              </view>
            </view>

            <!-- 工具面板 -->
            <view wx:if="{{item.activeTool}}" class="eh-scc-panel" aria-label="卡片工具面板">
              <view class="eh-scc-panel-head">
                <text class="eh-scc-panel-title">
                  {{item.activeTool === 'thumbnail' ? '缩略图设置' : item.activeTool === 'stats' ? '点击统计' : item.unavailableTitle}}
                </text>
                <text class="eh-scc-panel-close" bindtap="closeCardTool" aria-label="收起卡片工具">×</text>
              </view>

              <block wx:if="{{item.activeTool === 'thumbnail'}}">
                <text class="eh-scc-panel-desc">为这条链接添加图片或图标。</text>
                <image
                  wx:if="{{item.imageUrl}}"
                  class="eh-scc-panel-thumb"
                  src="{{item.imageUrl}}"
                  mode="aspectFill"
                />
                <view
                  class="eh-scc-panel-action"
                  data-sindex="{{sIndex}}"
                  data-iindex="{{iIndex}}"
                  data-key="{{item.imageKey}}"
                  bindtap="openThumbSource"
                >{{busy ? '上传中…' : item.imageUrl ? '更换缩略图' : '设置缩略图'}}</view>
                <view
                  wx:if="{{item.imageUrl}}"
                  class="eh-scc-panel-action"
                  data-sindex="{{sIndex}}"
                  data-iindex="{{iIndex}}"
                  data-key="{{item.imageKey}}"
                  bindtap="clearItemImage"
                >移除缩略图</view>
                <text wx:if="{{thumbWorksHint}}" class="eh-scc-panel-status" role="status">{{thumbWorksHint}}</text>
                <view class="eh-scc-panel-field">
                  <text class="eh-scc-panel-field-label">从素材库选择</text>
                  <picker
                    mode="selector"
                    range="{{thumbWorks}}"
                    range-key="title"
                    disabled="{{!thumbWorks.length}}"
                    data-sindex="{{sIndex}}"
                    data-iindex="{{iIndex}}"
                    data-key="{{item.imageKey}}"
                    bindchange="onThumbWorkPick"
                  >
                    <view class="eh-scc-panel-select {{!thumbWorks.length ? 'eh-scc-panel-select-off' : ''}}">
                      选择图片
                    </view>
                  </picker>
                </view>
                <view class="eh-scc-panel-field">
                  <text class="eh-scc-panel-field-label">使用图片链接</text>
                  <input
                    class="eh-scc-panel-input"
                    value="{{item.imageUrl}}"
                    placeholder="https://"
                    data-sindex="{{sIndex}}"
                    data-iindex="{{iIndex}}"
                    data-key="{{item.imageKey}}"
                    bindinput="onThumbUrlInput"
                  />
                </view>
              </block>

              <block wx:elif="{{item.activeTool === 'stats'}}">
                <!-- 对齐 App：blocked 文案在 tabs 前；insightTabs；范围说明；再 status -->
                <text
                  wx:if="{{item.toolStatsBlocked}}"
                  class="eh-scc-panel-status"
                  role="status"
                >{{item.toolStatsBlocked}}</text>
                <view class="eh-scc-insight-tabs" aria-label="统计维度">
                  <text class="eh-scc-insight-tab eh-scc-insight-tab-on">点击</text>
                  <text class="eh-scc-insight-tab">流量来源（未开通）</text>
                  <text class="eh-scc-insight-tab">国家／地区（未开通）</text>
                </view>
                <text class="eh-scc-panel-desc">统计范围：最近 30 天（UTC）。相同目标地址合并统计，不区分查询参数。</text>
                <text
                  wx:if="{{item.toolStatus && !item.toolStatsBlocked}}"
                  class="eh-scc-panel-status"
                  role="status"
                >{{item.toolStatus}}</text>
              </block>

              <block wx:elif="{{item.unavailableTitle}}">
                <text class="eh-scc-panel-desc">{{item.unavailableDesc}}</text>
                <text
                  wx:if="{{item.unavailableShowTopBadge}}"
                  class="eh-scc-unavailable"
                >未开通</text>

                <!-- 重点展示 / 访问限制 · 对齐 App option 行 -->
                <block wx:if="{{item.unavailableControl === 'radio' || item.unavailableControl === 'checkbox'}}">
                  <view
                    wx:for="{{item.unavailableOptions}}"
                    wx:key="key"
                    wx:for-item="opt"
                    class="eh-scc-unavail-opt"
                  >
                    <view
                      class="eh-scc-unavail-check {{item.unavailableControl === 'radio' ? 'eh-scc-unavail-radio' : ''}}"
                      aria-hidden="true"
                    ></view>
                    <view class="eh-scc-unavail-copy">
                      <text class="eh-scc-unavail-label">{{opt.label}}</text>
                      <text wx:if="{{opt.detail}}" class="eh-scc-unavail-detail">{{opt.detail}}</text>
                    </view>
                    <text class="eh-scc-unavailable">未开通</text>
                  </view>
                </block>

                <!-- 定时展示 · 对齐 App disabled datetime-local：未开通不可点选 -->
                <block wx:elif="{{item.unavailableControl === 'schedule'}}">
                  <view class="eh-scc-panel-field">
                    <text class="eh-scc-panel-field-label">开始展示</text>
                    <view class="eh-scc-datetime eh-scc-datetime-off" aria-label="开始展示日期时间（未开通）">
                      <picker mode="date" disabled="{{true}}">
                        <view class="eh-scc-datetime-slot eh-scc-datetime-empty"></view>
                      </picker>
                      <picker mode="time" disabled="{{true}}">
                        <view class="eh-scc-datetime-slot eh-scc-datetime-empty"></view>
                      </picker>
                      <text class="eh-scc-datetime-chevron" aria-hidden="true">▾</text>
                    </view>
                  </view>
                  <view class="eh-scc-panel-field">
                    <text class="eh-scc-panel-field-label">结束展示</text>
                    <view class="eh-scc-datetime eh-scc-datetime-off" aria-label="结束展示日期时间（未开通）">
                      <picker mode="date" disabled="{{true}}">
                        <view class="eh-scc-datetime-slot eh-scc-datetime-empty"></view>
                      </picker>
                      <picker mode="time" disabled="{{true}}">
                        <view class="eh-scc-datetime-slot eh-scc-datetime-empty"></view>
                      </picker>
                      <text class="eh-scc-datetime-chevron" aria-hidden="true">▾</text>
                    </view>
                  </view>
                </block>

                <!-- 显示规则 · 对齐 App 查看规则设置 → 国家／地区规则 dialog -->
                <block wx:elif="{{item.unavailableControl === 'rules'}}">
                  <view class="eh-scc-panel-action" bindtap="openRulesDialog">查看规则设置</view>
                </block>

                <text
                  wx:if="{{item.unavailableCurrent}}"
                  class="eh-scc-panel-status"
                >{{item.unavailableCurrent}}</text>
              </block>
            </view>

            <!-- 展开体 · 对齐 App EditHomeScreen itemFields + itemTools -->
            <view wx:if="{{item.expanded}}" class="eh-scc-body">
              <view class="eh-scc-item">
                <view class="eh-scc-item-fields">
                  <block wx:for="{{item.fieldRows}}" wx:key="key" wx:for-item="field">
                    <view class="eh-scc-field">
                      <text class="eh-scc-field-label">{{field.label}}</text>
                      <view wx:if="{{field.isImage}}" class="eh-scc-image-row">
                        <image
                          wx:if="{{field.value}}"
                          class="eh-scc-thumb"
                          src="{{field.value}}"
                          mode="aspectFill"
                        />
                        <view wx:else class="eh-scc-thumb eh-scc-thumb-empty"></view>
                        <button
                          class="eh-btn eh-btn-ghost eh-btn-inline"
                          data-sindex="{{sIndex}}"
                          data-iindex="{{iIndex}}"
                          data-key="{{field.key}}"
                          bindtap="pickItemImage"
                        >{{field.value ? '换一张' : '上传'}}</button>
                        <text
                          wx:if="{{field.value}}"
                          class="eh-scc-img-clear"
                          data-sindex="{{sIndex}}"
                          data-iindex="{{iIndex}}"
                          data-key="{{field.key}}"
                          bindtap="clearItemImage"
                          aria-label="去掉图片"
                        >×</text>
                      </view>
                      <picker
                        wx:elif="{{field.isColor}}"
                        mode="selector"
                        range="{{colorOptions}}"
                        range-key="label"
                        data-sindex="{{sIndex}}"
                        data-iindex="{{iIndex}}"
                        data-key="{{field.key}}"
                        bindchange="onItemColor"
                      >
                        <view class="eh-scc-field-input">{{field.colorLabel || field.value || '默认'}}</view>
                      </picker>
                      <textarea
                        wx:elif="{{field.isMultiline}}"
                        class="eh-scc-field-textarea"
                        value="{{field.value}}"
                        placeholder="{{field.placeholder}}"
                        auto-height
                        maxlength="400"
                        data-sindex="{{sIndex}}"
                        data-iindex="{{iIndex}}"
                        data-key="{{field.key}}"
                        bindinput="onItemField"
                      />
                      <input
                        wx:else
                        class="eh-scc-field-input"
                        value="{{field.value}}"
                        placeholder="{{field.placeholder}}"
                        data-sindex="{{sIndex}}"
                        data-iindex="{{iIndex}}"
                        data-key="{{field.key}}"
                        bindinput="onItemField"
                      />
                    </view>
                  </block>
                </view>
                <view class="eh-scc-item-tools">
                  <view
                    class="eh-scc-item-tool {{iIndex === 0 ? 'eh-scc-item-tool-off' : ''}}"
                    data-sindex="{{sIndex}}"
                    data-iindex="{{iIndex}}"
                    data-delta="-1"
                    bindtap="moveItem"
                    aria-label="上移"
                  >↑</view>
                  <view
                    class="eh-scc-item-tool {{iIndex === section.items.length - 1 ? 'eh-scc-item-tool-off' : ''}}"
                    data-sindex="{{sIndex}}"
                    data-iindex="{{iIndex}}"
                    data-delta="1"
                    bindtap="moveItem"
                    aria-label="下移"
                  >↓</view>
                  <view
                    class="eh-scc-item-tool eh-scc-item-tool-remove"
                    data-sindex="{{sIndex}}"
                    data-iindex="{{iIndex}}"
                    bindtap="removeLinkItem"
                    aria-label="删除这一条"
                  >×</view>
                </view>
              </view>
              <!-- 卡片布局 · 对齐 App StudioContentCard label.layout（body 内、item 外） -->
              <view wx:if="{{section.type !== 'skills'}}" class="eh-scc-layout">
                <text class="eh-scc-layout-label">卡片布局</text>
                <picker
                  mode="selector"
                  range="{{layoutPicker}}"
                  range-key="label"
                  data-sindex="{{sIndex}}"
                  data-iindex="{{iIndex}}"
                  bindchange="onItemLayout"
                >
                  <view class="eh-scc-layout-select">{{item.layoutLabel}}</view>
                </picker>
              </view>
            </view>
          </view>

          <!-- 整理内容 · 对齐 CollectionDestination -->
          <view wx:if="{{section.showDestination}}" class="eh-scc-dest">
            <text class="eh-scc-dest-label">整理内容</text>
            <picker
              mode="selector"
              range="{{section.moveOptions}}"
              range-key="label"
              data-sindex="{{sIndex}}"
              data-iindex="{{iIndex}}"
              bindchange="onMoveDestination"
            >
              <view class="eh-scc-dest-select">移到…</view>
            </picker>
          </view>
        </block>

        <view class="eh-scc-foot">
          <block wx:if="{{pendingDeleteSectionId === section.id}}">
            <view class="eh-scc-foot-confirm" role="group" aria-label="确认删除区块">
              <text class="eh-scc-foot-confirm-note">删除后，其中 {{section.memberCount}} 条内容也会移除。</text>
              <view class="eh-scc-foot-confirm-actions">
                <button
                  class="eh-scc-foot-btn"
                  bindtap="cancelRemoveSection"
                  hover-class="eh-scc-foot-btn-hover"
                >取消</button>
                <button
                  class="eh-scc-foot-btn eh-scc-foot-btn-danger eh-scc-foot-btn-solid"
                  data-sindex="{{sIndex}}"
                  bindtap="confirmRemoveSection"
                  hover-class="eh-scc-foot-btn-danger-hover"
                >确认删除</button>
              </view>
            </view>
          </block>
          <block wx:else>
            <button
              class="eh-scc-foot-btn eh-scc-foot-btn-add"
              data-sindex="{{sIndex}}"
              bindtap="addLinkItem"
              disabled="{{busy || section.memberCount >= 12}}"
              hover-class="eh-scc-foot-btn-hover"
            >＋ {{section.isLinkCollection ? '添加内容' : '添加一条'}}{{section.memberCount >= 12 ? '（最多 12 条）' : ''}}</button>
            <button
              class="eh-scc-foot-btn eh-scc-foot-btn-danger"
              data-sindex="{{sIndex}}"
              bindtap="requestRemoveSection"
              disabled="{{busy}}"
              hover-class="eh-scc-foot-btn-danger-hover"
            >删除{{section.isLinkCollection ? '合集' : '这个区块'}}</button>
          </block>
        </view>
      </view>
    </block>

    <view class="eh-brand-card">
      <view class="eh-brand-text">
        <text class="eh-brand-title">显示 MuuZi 品牌</text>
        <text class="eh-brand-desc">当前方案保留 MuuZi 品牌展示。</text>
      </view>
      <switch
        checked="{{draft.show_branding !== false}}"
        color="#2f6df4"
        bindchange="toggleBranding"
        aria-label="显示 MuuZi 品牌"
      />
    </view>

    <view class="eh-links-footnote">草稿自动保存 · 发布后访客可见</view>

    <!-- 合集编辑器 · 对齐 App MobileCollectionEditor（图2）全屏 -->
    <view
      wx:if="{{collectionOpen}}"
      class="eh-col-page"
      catchtouchmove="noop"
    >
      <view class="eh-col-page-safe" style="padding-top: {{navPadTop}}px;">
        <view class="eh-col-page-head" style="height: {{navHeight}}px;">
          <view class="eh-col-done" bindtap="closeCollection">完成</view>
          <text class="eh-col-status">{{statusCopy}}</text>
          <view
            class="eh-col-more"
            bindtap="toggleCollectionMenu"
            aria-label="合集更多操作"
            aria-expanded="{{collectionMenuOpen}}"
          >•••</view>
        </view>
      </view>

      <scroll-view scroll-y class="eh-col-page-scroll" enhanced show-scrollbar="{{false}}">
        <view class="eh-col-intro">
          <view class="eh-col-title-row">
            <input
              class="eh-col-title-input"
              value="{{collectionTitle}}"
              placeholder="添加合集标题（可选）"
              maxlength="40"
              focus="{{collectionTitleFocus}}"
              bindinput="onCollectionTitle"
              bindblur="onCollectionTitleBlur"
            />
            <view
              class="eh-col-title-edit"
              bindtap="focusCollectionTitle"
              aria-label="编辑合集标题"
            >✎</view>
          </view>
          <text class="eh-col-count">{{collectionMembers.length}} 张内容卡片</text>

          <view wx:if="{{collectionMenuOpen}}" class="eh-col-menu">
            <view class="eh-col-menu-btn" bindtap="toggleCollectionVisible">
              {{collectionVisible ? '在主页隐藏合集' : '在主页显示合集'}}
            </view>
            <view class="eh-col-menu-btn eh-col-menu-danger" bindtap="askDeleteCollection">
              删除合集
            </view>
          </view>
          <view wx:if="{{collectionConfirmDelete}}" class="eh-col-confirm" role="group" aria-label="确认删除合集">
            <text class="eh-col-confirm-text">删除合集会同时移除其中 {{collectionMembers.length}} 张内容卡片。</text>
            <view class="eh-col-confirm-row">
              <view class="eh-col-confirm-btn" bindtap="cancelDeleteCollection">取消</view>
              <view class="eh-col-confirm-btn eh-col-menu-danger" bindtap="deleteActiveCollection">确认删除</view>
            </view>
          </view>

          <text class="eh-col-h3">展示方式</text>
          <view class="eh-col-layouts" aria-label="合集布局">
            <view
              wx:for="{{collectionLayouts}}"
              wx:key="id"
              class="eh-col-layout {{item.selected ? 'eh-col-layout-on' : ''}}"
              data-id="{{item.id}}"
              bindtap="pickCollectionLayout"
            >
              <view class="eh-col-layout-icon eh-col-ico-{{item.icon}}" aria-hidden="true">
                <view wx:if="{{item.icon === 'list'}}" class="eh-ico-list">
                  <view class="eh-ico-bar"></view>
                  <view class="eh-ico-bar"></view>
                </view>
                <view wx:elif="{{item.icon === 'grid'}}" class="eh-ico-grid">
                  <view class="eh-ico-cell"></view>
                  <view class="eh-ico-cell"></view>
                  <view class="eh-ico-cell"></view>
                  <view class="eh-ico-cell"></view>
                </view>
                <view wx:elif="{{item.icon === 'carousel'}}" class="eh-ico-carousel">
                  <view class="eh-ico-side"></view>
                  <view class="eh-ico-center"></view>
                  <view class="eh-ico-side"></view>
                </view>
                <view wx:else class="eh-ico-showcase">
                  <view class="eh-ico-frame"></view>
                  <view class="eh-ico-corner eh-ico-tl"></view>
                  <view class="eh-ico-corner eh-ico-tr"></view>
                  <view class="eh-ico-corner eh-ico-bl"></view>
                  <view class="eh-ico-corner eh-ico-br"></view>
                </view>
              </view>
              <text class="eh-col-layout-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="eh-col-contents">
          <view class="eh-col-contents-head">
            <text class="eh-col-h3">内容卡片</text>
            <view class="eh-col-add" bindtap="addToCollection">＋ 添加</view>
          </view>

          <view
            wx:if="{{!collectionMembers.length}}"
            class="eh-col-empty"
            bindtap="addToCollection"
          >向合集添加第一张内容卡片</view>

          <view
            wx:for="{{collectionMembers}}"
            wx:key="key"
            class="eh-col-member"
          >
            <view
              class="eh-col-member-main"
              data-source="{{item.sourceId}}"
              data-index="{{item.index}}"
              bindtap="editCollectionMember"
            >
              <view class="eh-col-member-icon" aria-hidden="true">
                <image
                  class="eh-col-member-ico"
                  src="/assets/catalog-link.png"
                  mode="aspectFit"
                />
              </view>
              <view class="eh-col-member-text">
                <text class="eh-col-member-title">{{item.title}}</text>
                <text class="eh-col-member-desc">{{item.desc}}</text>
              </view>
              <text class="eh-col-member-chevron" aria-hidden="true">›</text>
            </view>
            <view
              class="eh-col-member-remove"
              data-source="{{item.sourceId}}"
              data-index="{{item.index}}"
              bindtap="removeCollectionMember"
            >移出合集</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底栏：添加 / 预览 / 设计 / 发布 -->
    <view wx:if="{{!collectionOpen}}" class="eh-links-toolbar" aria-label="主页编辑工具">
      <view class="eh-toolbar-btn" bindtap="openAddContent">
        <image class="eh-tb-ico" src="/assets/icon-ui-plus-ink.png" mode="aspectFit" aria-hidden="true" />
        <text>添加</text>
      </view>
      <view class="eh-toolbar-btn" bindtap="openPreview">
        <image class="eh-tb-ico" src="/assets/icon-ui-eye-ink.png" mode="aspectFit" aria-hidden="true" />
        <text>预览</text>
      </view>
      <view class="eh-toolbar-btn {{linksPanel === 'design' ? 'eh-toolbar-on' : ''}}" bindtap="toggleLinksDesign">
        <image class="eh-tb-ico" src="/assets/icon-ui-list-ink.png" mode="aspectFit" aria-hidden="true" />
        <text>设计</text>
      </view>
      <view
        class="eh-toolbar-btn eh-toolbar-on {{busy ? 'eh-toolbar-busy' : ''}}"
        bindtap="publish"
        aria-busy="{{busy}}"
      >
        <image class="eh-tb-ico" src="/assets/icon-ui-share-ink.png" mode="aspectFit" aria-hidden="true" />
        <text>{{busy ? '处理中' : '发布'}}</text>
      </view>
    </view>

    <!-- 添加内容：对齐 App AddContentSheet / ContentCatalogPicker -->
    <view wx:if="{{addContentOpen}}" class="eh-overlay eh-overlay-sheet" catchtouchmove="noop" bindtap="closeAddContent">
      <view class="eh-acs" catchtap="noop">
        <view class="eh-acs-head">
          <text class="eh-acs-title">{{addFormOpen ? addFormTitle : '添加内容'}}</text>
          <view class="eh-acs-close" bindtap="closeAddContent" aria-label="关闭">×</view>
        </view>

        <block wx:if="{{!addFormOpen}}">
          <view class="eh-acs-search">
            <input
              class="eh-acs-search-input"
              value="{{catalogQuery}}"
              placeholder="粘贴或搜索链接"
              confirm-type="search"
              bindinput="onCatalogQuery"
              bindconfirm="submitCatalogPaste"
            />
            <button
              wx:if="{{catalogPasteUrl}}"
              class="eh-acs-paste-btn"
              bindtap="submitCatalogPaste"
            >添加链接</button>
          </view>

          <scroll-view scroll-x class="eh-acs-pills" enable-flex>
            <view
              wx:for="{{catalogPills}}"
              wx:key="id"
              class="eh-acs-pill {{catalogCategory === item.id ? 'eh-acs-pill-on' : ''}}"
              data-id="{{item.id}}"
              bindtap="pickCatalogCategory"
            >{{item.label}}</view>
          </scroll-view>

          <view class="eh-acs-works" bindtap="copyStudio">
            <text>使用已上传的素材</text>
            <text class="eh-acs-works-link">素材库 ↗</text>
          </view>

          <view wx:if="{{catalogBusy}}" class="eh-state">正在加载可用内容…</view>
          <view wx:elif="{{catalogError}}" class="eh-acs-error" role="alert">
            <text>{{catalogError}}</text>
            <button class="eh-acs-retry" bindtap="reloadCatalog">重新加载</button>
          </view>
          <scroll-view wx:else scroll-y class="eh-acs-list">
            <block wx:for="{{catalogVisible}}" wx:key="id">
              <view wx:if="{{item.isGroup}}" class="eh-acs-group">{{item.groupTitle}}</view>
              <view
                wx:else
                class="eh-acs-row"
                data-id="{{item.id}}"
                bindtap="pickCatalogEntry"
              >
                <view class="eh-acs-icon {{item.brandClass}}" aria-hidden="true">
                  <image
                    class="eh-acs-ico-img"
                    src="{{item.iconSrc}}"
                    mode="aspectFit"
                  />
                </view>
                <view class="eh-acs-row-text">
                  <text class="eh-acs-row-title">{{item.title}}</text>
                  <text class="eh-acs-row-desc">{{item.description}}</text>
                </view>
                <image
                  class="eh-acs-chevron-img"
                  src="/assets/icon-ui-chevron-muted.png"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </view>
            </block>
            <view wx:if="{{!catalogVisible.length}}" class="eh-state">{{catalogEmptyCopy || '没有匹配的内容入口'}}</view>
          </scroll-view>
        </block>

        <block wx:else>
          <scroll-view scroll-y class="eh-acs-form">
            <view wx:for="{{addFormFields}}" wx:key="key" class="eh-field {{item.isMultiline ? '' : ''}}">
              <text class="eh-label">{{item.label}}</text>
              <textarea
                wx:if="{{item.isMultiline}}"
                class="eh-input eh-textarea"
                value="{{item.value}}"
                maxlength="400"
                placeholder="{{item.placeholder}}"
                auto-height
                data-key="{{item.key}}"
                bindinput="onAddFormField"
              />
              <picker
                wx:elif="{{item.isColor}}"
                mode="selector"
                range="{{colorOptions}}"
                range-key="label"
                data-key="{{item.key}}"
                bindchange="onAddFormColor"
              >
                <view class="eh-input eh-color-pick">
                  {{item.colorLabel}} ›
                </view>
              </picker>
              <input
                wx:else
                class="eh-input"
                value="{{item.value}}"
                maxlength="120"
                placeholder="{{item.placeholder}}"
                data-key="{{item.key}}"
                bindinput="onAddFormField"
              />
            </view>
            <view wx:if="{{addFormError}}" class="eh-error" role="alert">{{addFormError}}</view>
            <text class="eh-portrait-hint">保存到主页草稿，发布后访客可见。</text>
            <button class="eh-btn eh-btn-primary" bindtap="submitAddForm" disabled="{{addFormBusy}}">
              {{addFormBusy ? '处理中…' : '保存内容'}}
            </button>
            <button class="eh-btn eh-btn-ghost" bindtap="closeAddForm">返回目录</button>
          </scroll-view>
        </block>
      </view>
    </view>

    <!-- 社交快捷编辑 -->
    <view wx:if="{{editingSocial}}" class="eh-overlay" catchtouchmove="noop" bindtap="closeSocialEditor">
      <view class="eh-sheet" catchtap="noop">
        <view class="eh-sheet-title">{{editingSocialLabel}}</view>
        <view class="eh-field">
          <text class="eh-label">链接</text>
          <input
            class="eh-input"
            value="{{editingSocialUrl}}"
            placeholder="https://"
            bindinput="onEditingSocialUrl"
          />
        </view>
        <button class="eh-btn eh-btn-primary" bindtap="saveSocialShortcut">保存</button>
        <button class="eh-btn eh-btn-ghost" bindtap="closeSocialEditor">取消</button>
      </view>
    </view>

    <!-- 分享：对齐 App ProfileShareSheet -->
    <view wx:if="{{shareOpen}}" class="eh-overlay eh-overlay-sheet" catchtouchmove="noop" bindtap="closeLinksShare">
      <view class="eh-share-sheet" catchtap="noop">
        <view class="eh-sheet-handle"></view>
        <view class="eh-share-head">
          <text class="eh-share-title">分享我的 MuuZi</text>
          <view class="eh-share-close" bindtap="closeLinksShare" aria-label="关闭">×</view>
        </view>

        <view class="eh-share-identity">
          <image
            wx:if="{{draft.portrait_url}}"
            class="eh-share-avatar"
            src="{{draft.portrait_url}}"
            mode="aspectFill"
          />
          <view wx:else class="eh-share-avatar eh-portrait-fallback">{{portraitLetter}}</view>
          <text class="eh-share-name">{{draft.display_name || slug || '我的主页'}}</text>
          <text class="eh-share-tag">MuuZi · 让更多人遇见你</text>
        </view>

        <view class="eh-share-address" bindtap="copyShareUrl">
          <text class="eh-share-address-text">{{shareUrl || '主页地址暂不可用'}}</text>
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-link-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>

        <view wx:if="{{!shareUrl && !shareMissing}}" class="eh-share-hint" role="status">{{shareAvailability}}</view>
        <view wx:if="{{shareNote}}" class="eh-share-hint" role="status">{{shareNote}}</view>

        <view class="eh-share-option" bindtap="toggleShareBio">
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-list-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="eh-share-option-label">添加到社交简介</text>
          <image
            class="eh-share-chevron-img"
            src="/assets/icon-ui-chevron-muted.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <view wx:if="{{showShareBio}}" class="eh-share-expand">
          <text class="eh-label">社交简介</text>
          <textarea
            class="eh-share-bio"
            maxlength="300"
            value="{{shareBio}}"
            bindinput="onShareBioInput"
          />
          <text class="eh-share-hint">{{shareUrl || '发布后可附带主页链接'}}</text>
          <button class="eh-btn eh-btn-secondary eh-btn-inline" bindtap="copyShareBio">复制简介</button>
        </view>

        <view wx:if="{{shareMissing && !shareUrl}}" class="eh-share-expand" role="status">
          <text class="eh-share-hint">{{shareAvailability}}</text>
          <button class="eh-btn eh-btn-ghost" bindtap="closeLinksShare">知道了</button>
        </view>

        <view class="eh-share-option" bindtap="toggleShareQr">
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-expand-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="eh-share-option-label">主页二维码</text>
          <image
            class="eh-share-chevron-img"
            src="/assets/icon-ui-chevron-muted.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <view wx:if="{{showShareQr}}" class="eh-share-expand eh-share-qr-box">
          <image wx:if="{{shareQrImage}}" class="eh-share-qr" src="{{shareQrImage}}" mode="aspectFit" />
          <text wx:else class="eh-share-hint">正在生成二维码…</text>
          <text class="eh-share-hint">扫码打开你的 MuuZi 主页</text>
        </view>

        <view class="eh-share-option" bindtap="toggleShareCard">
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-person-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="eh-share-option-label">数字名片</text>
          <image
            class="eh-share-chevron-img"
            src="/assets/icon-ui-chevron-muted.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <view wx:if="{{showShareCard}}" class="eh-share-card">
          <text class="eh-share-card-name">{{draft.display_name || slug || '我的主页'}}</text>
          <text class="eh-share-card-url">{{shareUrl || '主页地址待发布'}}</text>
          <text class="eh-share-card-action" bindtap="copyShareCard">保存联系人名片</text>
          <text class="eh-share-card-hint">名片包含昵称{{shareUrl ? '和主页链接' : ''}}。</text>
        </view>

        <button
          class="eh-share-option"
          open-type="{{shareUrl ? 'share' : ''}}"
          bindtap="shareToOthers"
          disabled="{{shareBusy}}"
        >
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-share-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="eh-share-option-label">{{shareBusy ? '正在打开分享…' : '分享到…'}}</text>
          <image
            class="eh-share-chevron-img"
            src="/assets/icon-ui-chevron-muted.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </button>

        <button class="eh-share-option" bindtap="openSharePage">
          <image
            class="eh-share-ico"
            src="/assets/icon-ui-link-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <text class="eh-share-option-label">打开主页</text>
          <image
            class="eh-share-arrow-img"
            src="/assets/icon-ui-arrow-right-accent.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </button>
      </view>
    </view>

    <canvas
      wx:if="{{shareOpen}}"
      canvas-id="ehShareQr"
      class="eh-qr-canvas"
      style="width:280px;height:280px;"
    ></canvas>
  </block>

  <!-- ========== 完整编辑 / 个人资料（对齐 App EditHomeScreen editor） ========== -->
  <block wx:elif="{{phase === 'editing'}}">
    <view class="eh-editor {{profileOnly ? 'eh-profile-editor' : ''}}">
    <!-- 1. Topline -->
    <view wx:if="{{!profileOnly}}" class="eh-topline">
      <view class="eh-topline-main">
        <text class="eh-topline-address">{{addressDisplay}}</text>
        <text class="eh-topline-meta">{{publishedMetaCopy}}</text>
      </view>
      <text class="eh-topline-status">{{statusCopy}}</text>
    </view>

    <!-- 2–3. Cover + skins（profileOnly 跳过）· 对齐 App .section + .coverPreview + .swatches -->
    <block wx:if="{{!profileOnly}}">
      <view class="eh-section eh-cover-section">
        <text class="eh-section-h2">主页封面</text>
        <view class="eh-cover-preview">
          <image
            wx:if="{{draft.cover_url}}"
            class="eh-cover-img"
            src="{{draft.cover_url}}"
            mode="aspectFill"
            style="object-position: center {{draft.cover_position}}%;"
          />
          <text wx:else class="eh-cover-placeholder">添加一张代表你的封面</text>
        </view>
        <button class="eh-ghost" bindtap="pickCover" disabled="{{busy || uploadBusy}}">
          {{draft.cover_url ? '更换封面' : '上传封面'}}
        </button>
        <block wx:if="{{draft.cover_url}}">
          <view class="eh-field-box">
            <text class="eh-label">上下取景</text>
            <slider
              class="eh-cover-slider"
              min="0"
              max="100"
              step="1"
              value="{{draft.cover_position}}"
              activeColor="#2f6df4"
              block-size="20"
              bindchange="onCoverPosition"
              disabled="{{busy}}"
            />
          </view>
          <button class="eh-ghost" bindtap="removeCover" disabled="{{busy}}">移除封面</button>
        </block>
        <text class="eh-hint">建议使用横向图片，预览确认后发布到个人主页。</text>

        <view class="eh-eyebrow">主页配色</view>
        <view class="eh-swatches">
          <view
            wx:for="{{skinOptions}}"
            wx:key="id"
            class="eh-swatch {{item.selected ? 'eh-swatch-on' : ''}}"
            style="background: {{item.swatch}};"
            data-id="{{item.id}}"
            bindtap="pickSkin"
            aria-label="{{item.label}}"
          ></view>
          <text class="eh-swatch-label">{{skinLabel}}</text>
        </view>
      </view>
    </block>

    <!-- 4. PROFILE · 资料 · 对齐 App 同一 section：眉题 + 肖像行 + 独立描边字段 -->
    <view class="eh-section eh-profile-section">
      <view class="eh-eyebrow">{{profileOnly ? '头像与基本资料' : 'PROFILE · 资料'}}</view>
      <view class="eh-portrait-row">
        <view class="eh-portrait-box" aria-label="头像预览">
          <image
            wx:if="{{draft.portrait_url}}"
            class="eh-portrait-img"
            src="{{draft.portrait_url}}"
            mode="aspectFill"
          />
          <text wx:else class="eh-portrait-letter">{{portraitLetter}}</text>
        </view>
        <button class="eh-ghost" bindtap="pickPortrait" disabled="{{busy || uploadBusy}}">
          上传头像
        </button>
        <button class="eh-ghost" bindtap="randomPortrait" disabled="{{busy || uploadBusy}}">
          {{uploadBusy ? '处理中…' : '随机换一个'}}
        </button>
      </view>
      <view class="eh-field-box">
        <text class="eh-label">随机头像风格</text>
        <picker
          mode="selector"
          range="{{avatarStyleOptions}}"
          range-key="label"
          value="{{avatarStyleIndex}}"
          bindchange="onAvatarStyle"
          disabled="{{busy}}"
        >
          <view class="eh-control eh-picker-value">{{avatarStyleLabel}}</view>
        </picker>
      </view>
      <text class="eh-hint">选好风格，点「随机换一个」更换头像。</text>
      <view class="eh-field-box">
        <text class="eh-label">昵称（1–40 字，不可含受保护品牌）</text>
        <input
          class="eh-control"
          value="{{draft.display_name}}"
          maxlength="40"
          placeholder="怎么称呼你"
          bindinput="onNameInput"
        />
      </view>
      <view class="eh-field-box">
        <text class="eh-label">一句话</text>
        <input
          class="eh-control"
          value="{{draft.headline}}"
          maxlength="80"
          placeholder="你在做什么"
          bindinput="onHeadlineInput"
        />
      </view>
      <view class="eh-field-box">
        <text class="eh-label">简介</text>
        <textarea
          class="eh-control eh-control-area"
          value="{{draft.bio}}"
          maxlength="600"
          placeholder="让大家多了解一点你"
          auto-height
          bindinput="onBioInput"
        />
      </view>
    </view>

    <!-- 5. Cooperation · ProfileFields -->
    <view class="eh-coop">
      <view class="eh-coop-intro">
        <text class="eh-coop-h2">让合适的合作找到你</text>
        <text class="eh-coop-lead">介绍你的能力，也说说你正在寻找什么。</text>
      </view>
      <view class="eh-section eh-coop-card">
        <text class="eh-coop-h3">合作信息</text>
        <text class="eh-hint">以下内容会随主页公开，可按需要填写。</text>
        <view class="eh-field-box">
          <text class="eh-label">所在地</text>
          <input
            class="eh-control"
            value="{{meta.location}}"
            maxlength="80"
            placeholder="城市或地区"
            bindinput="onLocationInput"
          />
        </view>
        <text class="eh-hint">工作语言 · 可多选</text>
        <view class="eh-lang-row">
          <view
            wx:for="{{languageOptions}}"
            wx:key="id"
            class="eh-lang-chip {{item.on ? 'eh-lang-chip-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleLanguage"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="eh-section eh-coop-card">
        <view class="eh-coop-heading">
          <text class="eh-coop-h3">我能提供</text>
          <text class="eh-coop-count">{{meta.offers.length}}/20</text>
        </view>
        <text class="eh-hint">把擅长的事变成清晰的服务，让别人知道如何与你合作。</text>
        <view wx:if="{{!meta.offers.length}}" class="eh-coop-empty">例如：品牌设计、音乐制作、产品咨询</view>
        <view wx:for="{{meta.offers}}" wx:key="index" class="eh-offer-item">
          <view class="eh-field-box">
            <text class="eh-label">服务名称 {{index + 1}}</text>
            <input
              class="eh-control"
              value="{{item.label}}"
              maxlength="120"
              data-index="{{index}}"
              data-field="label"
              bindinput="onOfferField"
            />
          </view>
          <view class="eh-offer-pair">
            <view class="eh-field-box eh-offer-half">
              <text class="eh-label">参考报价 · 可不填</text>
              <input
                class="eh-control"
                type="digit"
                value="{{item.priceYuan}}"
                data-index="{{index}}"
                data-field="price"
                bindinput="onOfferField"
              />
            </view>
            <view class="eh-field-box eh-offer-half">
              <text class="eh-label">币种</text>
              <picker
                mode="selector"
                range="{{currencyOptions}}"
                range-key="label"
                data-index="{{index}}"
                bindchange="onOfferCurrency"
              >
                <view class="eh-control eh-picker-value">{{item.currencyLabel}}</view>
              </picker>
            </view>
          </view>
          <text class="eh-offer-note">按所选币种填写；0 表示免费，留空表示待沟通。报价由你提供。</text>
          <view class="eh-field-box">
            <text class="eh-label">交付天数 · 可不填</text>
            <input
              class="eh-control"
              type="number"
              value="{{item.leadDays}}"
              data-index="{{index}}"
              data-field="lead"
              bindinput="onOfferField"
            />
          </view>
          <text class="eh-remove" data-index="{{index}}" bindtap="removeOffer">移除服务 {{index + 1}}</text>
        </view>
        <button
          class="eh-ghost"
          bindtap="addOffer"
          disabled="{{meta.offers.length >= 20}}"
        >＋ 添加服务</button>
      </view>
      <view class="eh-section eh-coop-card">
        <view class="eh-coop-heading">
          <text class="eh-coop-h3">我在寻找</text>
          <text class="eh-coop-count">{{meta.wants.length}}/20</text>
        </view>
        <text class="eh-hint">写下希望获得的帮助，或想认识的合作伙伴。</text>
        <view wx:if="{{!meta.wants.length}}" class="eh-coop-empty">例如：寻找摄影师、合作开发一款产品</view>
        <view wx:for="{{meta.wants}}" wx:key="index" class="eh-offer-item">
          <view class="eh-field-box">
            <text class="eh-label">需求名称 {{index + 1}}</text>
            <input
              class="eh-control"
              value="{{item.label}}"
              maxlength="120"
              data-index="{{index}}"
              bindinput="onWantInput"
            />
          </view>
          <text class="eh-remove" data-index="{{index}}" bindtap="removeWant">删除需求 {{index + 1}}</text>
        </view>
        <button
          class="eh-ghost"
          bindtap="addWant"
          disabled="{{meta.wants.length >= 20}}"
        >＋ 添加需求</button>
      </view>
    </view>

    <block wx:if="{{!profileOnly}}">
      <!-- 6. LINKS · 社交链接 -->
      <view class="eh-section">
        <view class="eh-eyebrow">LINKS · 社交链接</view>
        <text class="eh-hint">这些在主页上是头像下面的一排图标，不是卡片。</text>
        <view
          wx:for="{{draft.socials}}"
          wx:key="index"
          class="eh-social-editor-row"
        >
          <picker
            mode="selector"
            range="{{socialKinds}}"
            range-key="label"
            data-index="{{index}}"
            bindchange="onSocialKind"
          >
            <view class="eh-control eh-social-kind">{{item.label || item.kind}}</view>
          </picker>
          <input
            wx:if="{{item.kind === 'wechat'}}"
            class="eh-control eh-social-url"
            value="{{item.wechat_id}}"
            placeholder="微信号"
            data-index="{{index}}"
            bindinput="onSocialWechat"
          />
          <input
            wx:else
            class="eh-control eh-social-url"
            value="{{item.url}}"
            placeholder="https://"
            data-index="{{index}}"
            bindinput="onSocialUrl"
          />
          <text class="eh-remove" data-index="{{index}}" bindtap="removeSocial">×</text>
        </view>
        <button class="eh-ghost" bindtap="addSocial">＋ 添加链接</button>
      </view>

      <!-- 7. SECTIONS · 区块 -->
      <view class="eh-section eh-sections-head">
        <view class="eh-eyebrow">SECTIONS · 区块</view>
      </view>
      <block wx:for="{{draft.sections}}" wx:key="id" wx:for-item="section" wx:for-index="sIndex">
        <view wx:if="{{!section.isCollectionChild}}" class="eh-section eh-block-card">
          <view class="eh-section-head">
            <text class="eh-section-type">{{section.typeLabel}}</text>
            <input
              class="eh-control eh-section-title"
              value="{{section.title}}"
              placeholder="区块标题"
              data-sindex="{{sIndex}}"
              bindinput="onSectionTitle"
            />
            <switch
              checked="{{section.visible !== false}}"
              color="#2f6df4"
              data-sindex="{{sIndex}}"
              bindchange="toggleSectionVisible"
            />
          </view>
          <view class="eh-section-tools">
            <text data-sindex="{{sIndex}}" data-delta="-1" bindtap="moveSection">上移</text>
            <text data-sindex="{{sIndex}}" data-delta="1" bindtap="moveSection">下移</text>
            <text class="eh-remove" data-sindex="{{sIndex}}" bindtap="removeSection">删除这个区块</text>
          </view>
          <view
            wx:for="{{section.items}}"
            wx:key="index"
            wx:for-item="item"
            wx:for-index="iIndex"
            class="eh-item"
          >
            <block wx:for="{{item.fieldRows}}" wx:key="key" wx:for-item="field">
              <text class="eh-item-field-label">{{field.label}}</text>
              <view wx:if="{{field.isImage}}" class="eh-scc-image-row">
                <image
                  wx:if="{{field.value}}"
                  class="eh-scc-thumb"
                  src="{{field.value}}"
                  mode="aspectFill"
                />
                <button
                  class="eh-ghost"
                  data-sindex="{{sIndex}}"
                  data-iindex="{{iIndex}}"
                  data-key="{{field.key}}"
                  bindtap="pickItemImage"
                >{{field.value ? '换一张' : '上传'}}</button>
                <text
                  wx:if="{{field.value}}"
                  class="eh-remove"
                  data-sindex="{{sIndex}}"
                  data-iindex="{{iIndex}}"
                  data-key="{{field.key}}"
                  bindtap="clearItemImage"
                >×</text>
              </view>
              <textarea
                wx:elif="{{field.isMultiline}}"
                class="eh-control eh-control-area eh-item-field"
                value="{{field.value}}"
                placeholder="{{field.placeholder}}"
                auto-height
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-key="{{field.key}}"
                bindinput="onItemField"
              />
              <input
                wx:elif="{{field.isText || field.isColor}}"
                class="eh-control"
                value="{{field.value}}"
                placeholder="{{field.placeholder || (field.isColor ? '配色：rose / sky…' : '')}}"
                data-sindex="{{sIndex}}"
                data-iindex="{{iIndex}}"
                data-key="{{field.key}}"
                bindinput="onItemField"
              />
            </block>
            <picker
              wx:if="{{item.showTikTokDisplay}}"
              mode="selector"
              range="{{tiktokDisplayOptions}}"
              range-key="label"
              data-sindex="{{sIndex}}"
              data-iindex="{{iIndex}}"
              bindchange="onTikTokDisplay"
            >
              <view class="eh-display-pick">
                TikTok 展示：{{item.tiktokDisplayLabel}}
                {{item.tiktokGalleryReady ? '' : '（画廊未就绪，仅链接可用）'}} ›
              </view>
            </picker>
            <picker
              wx:if="{{item.showInstagramDisplay}}"
              mode="selector"
              range="{{instagramDisplayOptions}}"
              range-key="label"
              data-sindex="{{sIndex}}"
              data-iindex="{{iIndex}}"
              bindchange="onInstagramDisplay"
            >
              <view class="eh-display-pick">
                Instagram 展示：{{item.instagramDisplayLabel}}
                {{item.instagramGalleryReady ? '' : '（画廊未就绪，仅链接可用）'}} ›
              </view>
            </picker>
            <text
              class="eh-remove"
              data-sindex="{{sIndex}}"
              data-iindex="{{iIndex}}"
              bindtap="removeLinkItem"
            >删除条目</text>
          </view>
          <button
            class="eh-ghost"
            data-sindex="{{sIndex}}"
            bindtap="addLinkItem"
          >＋ 添加一条</button>
        </view>
      </block>
      <button class="eh-ghost eh-add-section" bindtap="addLinksSection">
        ＋ 新建区块
      </button>
    </block>

    <view wx:if="{{saveError}}" class="eh-error" role="alert">{{saveError}}</view>

    <!-- 8. 预览草稿 -->
    <view class="eh-preview-draft-row">
      <view class="eh-ghost" bindtap="openPreview">预览草稿</view>
    </view>

    <!-- 9–10. SHARE + publish（profileOnly 仍保留发布） -->
    <block wx:if="{{!profileOnly}}">
      <view class="eh-section eh-share-section">
        <view class="eh-eyebrow">SHARE · 预览与分享</view>
        <block wx:if="{{publishedAt}}">
          <view wx:if="{{addressDisplay && addressDisplay !== '发布后可分享'}}" class="eh-address-topline">
            {{addressDisplay}}
          </view>
          <view class="eh-share-grid-row">
            <view class="eh-ghost eh-ghost-flex" bindtap="openFinishedProduct">看成品</view>
            <view
              class="eh-ghost eh-ghost-flex {{shareBusy ? 'eh-ghost-busy' : ''}}"
              bindtap="sharePageLink"
            >分享 {{addressDisplay}}</view>
          </view>
          <view class="eh-share-grid-row">
            <block wx:if="{{shortLink}}">
              <view class="eh-short-code">{{shortLinkDisplay}}</view>
              <view
                class="eh-ghost eh-ghost-flex {{shareBusy ? 'eh-ghost-busy' : ''}}"
                bindtap="shareShortLink"
              >分享短链接</view>
            </block>
            <view
              wx:else
              class="eh-ghost eh-ghost-flex"
              bindtap="makeShortLink"
            >要一个短链接</view>
          </view>
          <view class="eh-share-hint-text">{{shortLinkHint}}</view>
        </block>
        <view wx:else class="eh-share-hint-text">
          先发布，才有能分享出去的地址。可先点上方「预览草稿」看现在改成什么样了。
        </view>
        <view wx:if="{{shareNote}}" class="eh-share-hint-text" role="status">{{shareNote}}</view>
      </view>
    </block>

    <view class="eh-publish-foot">
      <button
        class="eh-btn eh-btn-publish"
        bindtap="publish"
        disabled="{{busy}}"
      >
        <text class="eh-publish-label">{{busy ? '正在发布…' : publishLabel}}</text>
        <text class="eh-publish-arrow" aria-hidden="true">↑</text>
      </button>
      <view wx:if="{{isOrg}}" class="eh-studio-hint">
        企业主页由所有者和管理员编辑；成员邀请、企业套餐与认证可返回企业空间操作。
      </view>
      <view wx:elif="{{profileOnly}}" class="eh-studio-hint">
        修改会自动保存草稿；发布时会一并发布当前主页的其他草稿修改。
      </view>
      <view wx:else class="eh-studio-hint">
        模板、自定义域名、作品库在网页版 Studio 里：{{studioHost}}
      </view>
    </view>
    </view>
  </block>
</view>

<!-- 预览全屏：对 linksOnly 与完整「设计」编辑器共用 -->
<view wx:if="{{previewOpen}}" class="eh-preview-full" catchtouchmove="noop">
  <view class="eh-preview-nav-wrap">
    <view
      class="eh-preview-nav"
      style="padding-top: {{navPadTop}}px; padding-right: {{navPadRight}}px;"
    >
      <view class="eh-preview-nav-inner" style="height: {{navHeight}}px;">
        <view class="eh-links-header-btn" bindtap="closePreview" aria-label="返回">
          <image
            class="eh-ico-back-img"
            src="/assets/icon-ui-back-ink.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <view class="eh-preview-nav-titles">
          <text class="eh-preview-nav-title">主页预览</text>
        </view>
        <view class="eh-links-header-btn eh-links-nav-spacer" aria-hidden="true"></view>
      </view>
    </view>
    <view class="eh-links-share-bar" style="padding-right: {{sharePadRight}}px;">
      <view class="eh-links-share-btn" bindtap="openLinksShare" aria-label="分享主页">
        <image
          class="eh-share-img"
          src="/assets/icon-ui-share-ink.png"
          mode="aspectFit"
          aria-hidden="true"
        />
      </view>
    </view>
    <text class="eh-preview-nav-sub">草稿效果 · 尚未发布的修改仅自己可见</text>
  </view>

  <view wx:if="{{previewBusy}}" class="eh-state">正在载入预览…</view>
  <scroll-view wx:else scroll-y class="eh-preview-scroll">
    <view wx:if="{{previewError}}" class="eh-error eh-preview-warn" role="alert">{{previewError}}</view>
    <home-page-preview
      wx:if="{{previewModel}}"
      model="{{previewModel}}"
      show-draft-badge="{{true}}"
      audio-playing-key="{{previewAudioKey}}"
      bind:share="onPreviewShare"
      bind:openitem="onPreviewOpenItem"
      bind:audiotap="onPreviewAudioTap"
    />
  </scroll-view>
</view>

<canvas
  wx:if="{{avatarCanvasOn}}"
  canvas-id="ehAvatarCanvas"
  class="eh-avatar-canvas"
  style="width:200px;height:200px;"
></canvas>

<!-- 对齐 App presentShareChoices：选择分享地址弹框 -->
<view
  wx:if="{{sharePickerOpen}}"
  class="eh-overlay eh-overlay-center"
  catchtouchmove="noop"
  bindtap="closeSharePicker"
>
  <view class="eh-share-picker" catchtap="noop" aria-label="选择分享地址">
    <text class="eh-share-picker-title">分享</text>
    <text class="eh-share-picker-note">选择访问地址，主页内容和账号所属节点保持不变。</text>
    <radio-group bindchange="onSharePickerSelect">
      <label
        wx:for="{{sharePickerOptions}}"
        wx:key="id"
        class="eh-share-picker-option"
      >
        <radio value="{{item.id}}" checked="{{item.id === sharePickerSelected}}" color="#254ee8" />
        <view class="eh-share-picker-option-text">
          <text>{{item.label}}</text>
          <text class="eh-share-picker-url">{{item.display}}</text>
        </view>
      </label>
    </radio-group>
    <view wx:if="{{sharePickerStatus}}" class="eh-share-picker-status" role="status">{{sharePickerStatus}}</view>
    <view class="eh-share-picker-foot">
      <button class="eh-share-picker-cancel" bindtap="closeSharePicker" disabled="{{sharePickerBusy}}">取消</button>
      <button class="eh-share-picker-send" bindtap="confirmSharePicker" disabled="{{sharePickerBusy}}">
        {{sharePickerBusy ? '正在打开分享…' : '分享此地址'}}
      </button>
    </view>
  </view>
</view>

<!-- 对齐 App StudioCardTools 选择缩略图来源 dialog -->
<view
  wx:if="{{thumbSourceOpen}}"
  class="eh-overlay eh-overlay-center"
  catchtouchmove="noop"
  bindtap="closeThumbSource"
  aria-label="选择缩略图来源"
>
  <view class="eh-thumb-source" catchtap="noop">
    <view class="eh-thumb-source-head">
      <text class="eh-thumb-source-title">选择缩略图来源</text>
      <text class="eh-thumb-source-close" bindtap="closeThumbSource" aria-label="关闭缩略图来源">×</text>
    </view>
    <view class="eh-thumb-source-list">
      <view class="eh-thumb-source-row" bindtap="pickThumbFromSource">
        <text>上传自己的图片</text>
        <text class="eh-thumb-source-chevron">›</text>
      </view>
      <view class="eh-thumb-source-row eh-thumb-source-off">
        <text>从 Tabler 图标中选择</text>
        <text class="eh-scc-unavailable">未开通</text>
      </view>
      <view class="eh-thumb-source-row eh-thumb-source-off">
        <text>用 AI 生成缩略图</text>
        <text class="eh-scc-unavailable">未开通</text>
      </view>
      <view class="eh-thumb-source-row eh-thumb-source-off">
        <text>使用 Canva 设计</text>
        <text class="eh-scc-unavailable">未开通</text>
      </view>
    </view>
  </view>
</view>

<!-- 对齐 App StudioCardTools 国家／地区规则 dialog -->
<view
  wx:if="{{rulesDialogOpen}}"
  class="eh-overlay eh-overlay-center"
  catchtouchmove="noop"
  bindtap="closeRulesDialog"
  aria-label="国家／地区规则"
>
  <view class="eh-rules-dialog" catchtap="noop">
    <view class="eh-rules-dialog-head">
      <text class="eh-rules-dialog-title">国家／地区规则</text>
      <text class="eh-rules-dialog-close" bindtap="closeRulesDialog" aria-label="关闭地区规则">×</text>
    </view>
    <text class="eh-rules-dialog-note">未开通 · 以下为功能预览，不会保存或影响访客看到的内容。</text>
    <view class="eh-rules-dialog-field">
      <text class="eh-rules-dialog-label">如果访客所在国家／地区</text>
      <picker
        mode="selector"
        range="{{['属于','不属于']}}"
        bindchange="onRulesBelongPick"
      >
        <view class="eh-rules-dialog-select">{{rulesBelong}}</view>
      </picker>
    </view>
    <view class="eh-rules-dialog-field">
      <text class="eh-rules-dialog-label">国家／地区</text>
      <view class="eh-rules-dialog-select eh-rules-dialog-select-off">国家／地区列表未开通</view>
    </view>
    <view class="eh-rules-dialog-field">
      <text class="eh-rules-dialog-label">那么</text>
      <picker
        mode="selector"
        range="{{['隐藏这条链接','显示这条链接']}}"
        bindchange="onRulesActionPick"
      >
        <view class="eh-rules-dialog-select">{{rulesAction}}</view>
      </picker>
    </view>
    <view class="eh-rules-dialog-foot">
      <text class="eh-rules-dialog-cancel" bindtap="closeRulesDialog">取消</text>
      <text class="eh-rules-dialog-apply eh-rules-dialog-apply-off">应用（未开通）</text>
    </view>
  </view>
</view>

<!-- 对齐 App publishFeedback：全模式固定底提示（含 linksOnly），失败时附带 saveError -->
<view
  wx:if="{{publishFeedback}}"
  class="eh-publish-feedback"
  role="status"
>
  <text class="eh-publish-feedback-text">
    {{publishFeedback}}<block wx:if="{{!busy && saveError}}"> {{saveError}}</block>
  </text>
  <text
    wx:if="{{!busy}}"
    class="eh-publish-feedback-close"
    bindtap="closePublishFeedback"
    aria-label="关闭发布提示"
  >关闭</text>
</view>
