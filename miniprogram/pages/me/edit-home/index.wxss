.eh-cover-section {
  /* inherits .eh-section */
}

/* App .coverPreview: aspect-ratio 3/1; radius 16px; accent-wash; 12px muted */
.eh-cover-preview {
  width: 100%;
  aspect-ratio: 3 / 1;
  height: auto;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--app-accent-wash);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.eh-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.eh-cover-placeholder {
  font-size: 24rpx;
  color: var(--app-muted);
  padding: 24rpx;
  text-align: center;
  line-height: 1.45;
}

.eh-cover-slider {
  margin: 0;
  width: 100%;
}

/* App .ghost: card bg, line border, radius 14px, pad 10×14, 13px ink */
.eh-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  width: auto;
  margin: 0;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--app-card) !important;
  border: 1rpx solid var(--app-line) !important;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--app-ink) !important;
  font-weight: 400;
  text-align: center;
  box-sizing: border-box;
}

.eh-ghost::after {
  border: none;
}

.eh-ghost[disabled] {
  opacity: 0.5;
}

.eh-ghost-flex {
  flex: 1;
  display: flex;
  align-self: stretch;
  width: auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eh-ghost-busy {
  opacity: 0.5;
  pointer-events: none;
}

.eh-hint {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--app-muted);
}

.eh-eyebrow {
