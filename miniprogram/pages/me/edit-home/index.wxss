.eh-portrait-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 28rpx;
}

.eh-portrait-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: var(--app-accent-wash);
  color: var(--app-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  overflow: hidden;
}

.eh-portrait-img {
  width: 100%;
  height: 100%;
  display: block;
}

.eh-portrait-letter {
