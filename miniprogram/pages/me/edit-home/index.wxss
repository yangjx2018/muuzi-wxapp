.eh-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  width: auto;
  margin: 0;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--app-card) !important;
  border: 1rpx solid var(--app-line) !important;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--app-ink) !important;
  font-weight: 400;
  text-align: center;
  box-sizing: border-box;
}

.eh-ghost::after {
  border: none;
