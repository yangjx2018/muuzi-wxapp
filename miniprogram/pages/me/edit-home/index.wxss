  border-radius: 20rpx;
  background: #fff;
  font-size: 30rpx;
  color: #20232b;
}

.eh-scc-body {
  border-top: 1rpx solid #edf0f6;
  padding: 24rpx;
}
.eh-scc-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: var(--app-bg, #f4f6fb);
}
.eh-scc-item-fields {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.eh-scc-field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 0;
}
.eh-scc-field-label {
  display: block;
  font-size: 21rpx;
  color: #8b929c;
  margin-bottom: 0;
  line-height: 1.3;
}
/* 微信 input：禁止上下 padding，否则字被裁半（对齐 app.wxss .field-input） */
.eh-scc-field-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde0e6;
  background: #fff;
  font-size: 28rpx;
  line-height: 88rpx;
  color: var(--app-ink, #20232b);
}
.eh-scc-field-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde0e6;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--app-ink, #20232b);
  min-height: 140rpx;
}
.eh-scc-image-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
}
.eh-scc-thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #e9edf4;
  flex: none;
  overflow: hidden;
}
.eh-scc-thumb-empty {
  border: 1rpx dashed #cfd5e0;
}
.eh-scc-img-clear {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #fff;
  color: #69717b;
  font-size: 32rpx;
  line-height: 1;
  flex: none;
}
/* layout · 对齐 StudioContentCard .layout（全宽 bordered select，在 item 外） */
.eh-scc-layout {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #69717b;
}
.eh-scc-layout-label {
  font-size: 24rpx;
  color: #69717b;
}
.eh-scc-layout-select {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e2e6f0;
  border-radius: 20rpx;
  background: #f8f9fc;
  font-size: 28rpx;
  line-height: 88rpx;
  color: var(--app-ink, #20232b);
}
.eh-scc-item-tools {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.eh-scc-item-tool {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #69717b;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.eh-scc-item-tool-off {
  opacity: 0.35;
  pointer-events: none;
}
.eh-scc-item-tool-remove {
  color: #b64242;
}
.eh-scc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 24rpx 28rpx;
}
/* 对齐 App .cardFoot .ghost / .danger：产品化脚栏按钮，非纯文字链 */
.eh-scc-foot-btn {
  margin: 0;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 500;
  background: var(--app-card, #fff);
  color: var(--app-ink, #20232b);
  border: 1rpx solid var(--app-line, #e5e8f0);
  box-sizing: border-box;
}
.eh-scc-foot-btn::after {
  border: none;
}
.eh-scc-foot-btn[disabled] {
  opacity: 0.45;
}
.eh-scc-foot-btn-hover {
  opacity: 0.88;
}
.eh-scc-foot-btn-add {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: var(--app-ink, #20232b);
  background: #f4f6fb;
  border-color: #e2e6f0;
}
.eh-scc-foot-btn-danger {
  flex: none;
  background: transparent;
  border-color: transparent;
  color: #c45b5b;
  padding: 18rpx 24rpx;
}
.eh-scc-foot-btn-solid {
  background: rgba(196, 91, 91, 0.1);
  border-color: rgba(196, 91, 91, 0.28);
}
.eh-scc-foot-btn-danger-hover {
  opacity: 0.82;
  background: rgba(196, 91, 91, 0.08);
}
.eh-scc-foot-confirm {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0 0;
}
.eh-scc-foot-confirm-note {
  font-size: 24rpx;
  line-height: 1.55;
  color: #69717b;
}
.eh-scc-foot-confirm-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}
.eh-scc-foot-confirm-actions .eh-scc-foot-btn {
  flex: none;
}

.eh-col-summary {
  margin: 0 0 20rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid #e5e8f0;
  border-radius: 48rpx;
  background: #fff;
}
.eh-col-summary-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.eh-col-summary-title { flex: 1; min-width: 0; }
.eh-col-summary-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--app-ink);
}
.eh-col-summary-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8b929c;
}
.eh-col-prompt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: #edf2ff;
  color: var(--app-accent);
  font-size: 28rpx;
}
.eh-col-prompt-icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-accent);
}
.eh-col-prompt-grid {
  width: 32rpx;
  height: 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
}
.eh-col-prompt-cell {
  border-radius: 3rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  background: transparent;
}
.eh-col-prompt-chevron {
  margin-left: auto;
  font-size: 36rpx;
}

/* 合集编辑全屏 · 对齐 App MobileCollection.module.css */
.eh-col-page {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.eh-col-page-safe {
  background: #fff;
  border-bottom: 1rpx solid #e5e8f0;
  flex: none;
}
.eh-col-page-head {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 16rpx;
  box-sizing: border-box;
}
.eh-col-done {
  color: var(--app-accent);
  font-weight: 600;
  font-size: 30rpx;
  padding: 12rpx 8rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.eh-col-status {
  margin-left: auto;
  font-size: 26rpx;
  color: #8b929c;
}
.eh-col-more {
  color: var(--app-accent);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 8rpx 12rpx;
  min-width: 72rpx;
  text-align: center;
  line-height: 1;
}
.eh-col-page-scroll {
  flex: 1;
  height: 0;
  background: #fff;
}
.eh-col-intro {
  padding: 40rpx 40rpx 8rpx;
}
.eh-col-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.eh-col-title-input {
  flex: 1;
  min-width: 0;
  font-size: 42rpx;
  font-weight: 600;
  color: var(--app-ink);
  padding: 8rpx 0;
  background: transparent;
}
.eh-col-title-edit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b929c;
  font-size: 32rpx;
  flex: none;
}
.eh-col-count {
  display: block;
  margin: 16rpx 0 40rpx;
  font-size: 28rpx;
  color: #8b929c;
}
.eh-col-menu {
  margin: 0 0 28rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: var(--app-bg);
}
.eh-col-menu-btn {
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  color: var(--app-ink);
  font-size: 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}
.eh-col-menu-btn:last-child { margin-bottom: 0; }
.eh-col-menu-danger { color: #ba3e49; }
.eh-col-confirm {
  margin: 0 0 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--app-bg);
}
.eh-col-confirm-text {
  display: block;
  font-size: 26rpx;
  color: #69717b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.eh-col-confirm-row {
  display: flex;
  gap: 16rpx;
}
.eh-col-confirm-btn {
  flex: 1;
  min-height: 80rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.eh-col-h3 {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-ink);
  margin: 0 0 28rpx;
}
.eh-col-layouts {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.eh-col-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 0;
  color: #8b929c;
  font-size: 24rpx;
}
.eh-col-layout-icon {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 40rpx;
  background: var(--app-bg);
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.eh-col-layout-on {
  color: var(--app-accent);
  font-weight: 600;
}
.eh-col-layout-on .eh-col-layout-icon {
  border-color: var(--app-accent);
  background: #edf2ff;
  color: var(--app-accent);
}
.eh-col-layout-label { font-size: 24rpx; }

.eh-ico-list {
  width: 52%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.eh-ico-bar {
  height: 18rpx;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}
.eh-ico-grid {
  width: 52%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}
.eh-ico-cell {
  aspect-ratio: 1;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}
.eh-ico-carousel {
  width: 70%;
  height: 52%;
  display: flex;
  align-items: stretch;
  gap: 6rpx;
}
.eh-ico-side {
  width: 10rpx;
  border-radius: 4rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}
.eh-ico-center {
  flex: 1;
  border-radius: 8rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}
.eh-ico-showcase {
  position: relative;
  width: 56%;
  aspect-ratio: 1;
}
.eh-ico-frame {
  position: absolute;
  inset: 12%;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.eh-ico-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-color: currentColor;
  border-style: solid;
  box-sizing: border-box;
}
.eh-ico-tl { top: 0; left: 0; border-width: 3rpx 0 0 3rpx; }
.eh-ico-tr { top: 0; right: 0; border-width: 3rpx 3rpx 0 0; }
.eh-ico-bl { bottom: 0; left: 0; border-width: 0 0 3rpx 3rpx; }
.eh-ico-br { bottom: 0; right: 0; border-width: 0 3rpx 3rpx 0; }

.eh-col-contents {
  background: var(--app-bg);
  padding: 40rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  min-height: 50vh;
}
.eh-col-contents-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.eh-col-contents-head .eh-col-h3 { margin: 0; }
.eh-col-add {
  min-height: 72rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e8f0;
  background: #fff;
  color: var(--app-accent);
  font-size: 26rpx;
  display: flex;
  align-items: center;
}
.eh-col-empty {
  padding: 64rpx 16rpx;
  text-align: center;
  color: #8b929c;
  font-size: 28rpx;
}
.eh-col-member {
  background: #fff;
  border-radius: 44rpx;
  padding: 28rpx 28rpx 12rpx;
  margin-bottom: 20rpx;
}
.eh-col-member-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
}
.eh-col-member-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #edf2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.eh-col-member-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.eh-col-member-text {
  flex: 1;
  min-width: 0;
}
.eh-col-member-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--app-ink);
  overflow-wrap: anywhere;
}
.eh-col-member-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b929c;
  overflow-wrap: anywhere;
  line-height: 1.4;
}
.eh-col-member-chevron {
  font-size: 36rpx;
  color: #c0c4cc;
  flex: none;
  padding: 0 4rpx;
}
.eh-col-member-remove {
  display: block;
  text-align: right;
  margin-top: 4rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #8b929c;
}
.eh-danger-text { color: #ba3e49 !important; }
.eh-cover-box {
  width: 100%;
  aspect-ratio: 3 / 1;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e9edf4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.eh-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.eh-cover-ph {
  font-size: 26rpx;
  color: #8b929c;
}
.eh-cover-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
