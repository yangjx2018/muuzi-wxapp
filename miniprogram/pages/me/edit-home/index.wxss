/* ===== EditHome full-editor parity · 对齐 App EditHomeScreen.module.css ===== */

/* App: .editor 下 .section = margin 14px 16px; padding 20px 16px; radius 20px; gap 16px */
.eh-editor {
  margin: 0 -32rpx;
  padding-bottom: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
  min-width: 0;
}

.eh-section {
  margin: 28rpx 32rpx 0;
  padding: 40rpx 32rpx;
  background: var(--app-card);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-sizing: border-box;
  min-width: 0;
}

.eh-section-h2 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--app-ink);
  line-height: 1.2;
}

.eh-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin: 8rpx 40rpx 0;
  padding: 0 4rpx 12rpx;
