}

.eh-topline-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* App .editor .address: inherit font, 12px, ink */
.eh-topline-address {
  font-size: 24rpx;
  color: var(--app-ink);
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.eh-topline-meta {
  font-size: 23rpx;
  color: var(--app-muted);
  line-height: 1.4;
  margin-top: 2rpx;
