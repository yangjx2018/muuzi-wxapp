  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(21, 23, 30, 0.45);
  margin: 0;
}

/* App .swatches gap 10px; .swatch 34px + 3px transparent border + inset white ring */
.eh-swatches {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
}

.eh-swatch {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
  flex: none;
  padding: 0;
}

.eh-swatch-on {
  border-color: var(--app-ink);
}

.eh-swatch-label {
  margin-left: auto;
  font-size: 25rpx;
  color: var(--app-muted);
}

