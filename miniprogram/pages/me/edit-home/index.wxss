.eh {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 8rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
}

.eh-links-mode {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.eh-header-safe {
  padding-top: calc(16rpx + env(safe-area-inset-top));
}

.eh-header {
  display: grid;
  grid-template-columns: 120rpx 1fr 180rpx;
  align-items: center;
  padding: 16rpx 0 24rpx;
  gap: 8rpx;
}

/* 与微信胶囊垂直对齐的自定义顶栏 */
.eh-links-nav-wrap {
  margin: 0 -32rpx;
  padding: 0 16rpx 0 8rpx;
  background: var(--app-bg);
}

.eh-links-nav {
  box-sizing: border-box;
}

.eh-links-nav-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.eh-links-header-btn {
  width: 72rpx;
  height: 100%;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.eh-links-nav-spacer {
  visibility: hidden;
  pointer-events: none;
}

.eh-links-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--app-ink);
  line-height: 1.1;
}

.eh-links-share-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  min-height: 72rpx;
  padding: 4rpx 0 8rpx;
  box-sizing: border-box;
}

.eh-links-share-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eh-share-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.eh-share-img-sm {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.eh-links-share-btn {
  color: var(--app-ink);
}

.eh-preview-share-mini {
  color: var(--app-accent);
}

.eh-ico-back {
  width: 28rpx;
  height: 28rpx;
  border-left: 4rpx solid var(--app-ink);
  border-bottom: 4rpx solid var(--app-ink);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.eh-ico-back-sm {
  width: 18rpx;
  height: 18rpx;
  border-width: 3rpx;
  margin: 0 4rpx 0 0;
  border-color: var(--app-accent);
}

/* 社交快捷：对齐 App StudioSocialShortcuts（品牌图标 PNG） */
.eh-social-row {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  padding-top: 12rpx;
}

.eh-social-chip {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: transparent;
  border: none;
}

.eh-social-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
  padding: 6rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eh-social-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.eh-social-on.eh-social-instagram .eh-social-icon-wrap {
  background: radial-gradient(circle at 25% 100%, #ffcf61, #fa405c 45%, #943bd0 85%);
}

.eh-social-plus {
  position: absolute;
  right: -2rpx;
  top: -6rpx;
  width: 26rpx;
  height: 26rpx;
  border: 1rpx solid #dedfdd;
  border-radius: 50%;
  background: #fff;
  color: #767c78;
  font-size: 20rpx;
  line-height: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.eh-social-add {
  width: 50rpx;
  height: 50rpx;
  margin-left: 6rpx;
  border-radius: 50%;
  background: #eff0ed;
}

.eh-links-identity {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  align-items: center;
  gap: 28rpx;
  padding: 8rpx 0 36rpx;
  border-bottom: 1rpx solid var(--app-line);
}

.eh-links-bio {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.eh-links-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--app-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eh-links-sub {
  font-size: 26rpx;
  color: var(--app-muted);
  line-height: 1.4;
}

.eh-links-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--app-accent-wash);
  justify-self: end;
}

.eh-links-avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--app-accent);
}

.eh-links-actions {
  padding: 36rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.eh-add-content {
  margin: 0;
}

.eh-links-actions-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.eh-links-count {
  font-size: 20rpx;
  color: var(--app-muted);
}

.eh-links-error {
  margin-top: 20rpx;
  text-align: center;
}

.eh-links-empty {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  text-align: center;
  color: var(--app-muted);
  padding: 40rpx 24rpx;
}

.eh-links-empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: #e8eeff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eh-links-empty-img {
  width: 56rpx;
  height: 56rpx;
}

.eh-links-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--app-ink);
}

.eh-links-empty-desc {
  font-size: 24rpx;
  line-height: 1.55;
  max-width: 420rpx;
}

.eh-brand-card {
  margin-top: 40rpx;
  padding: 36rpx;
  border-radius: 36rpx;
  background: var(--app-card);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.eh-brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.eh-brand-title {
  font-size: 28rpx;
  font-weight: 600;
}

.eh-brand-desc {
  font-size: 22rpx;
  color: var(--app-muted);
  line-height: 1.45;
}

.eh-links-footnote {
  padding: 28rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-muted);
}

.eh-links-toolbar {
  position: fixed;
  z-index: 20;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  padding: 16rpx 8rpx;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 48rpx rgba(32, 45, 73, 0.12);
  border: 1rpx solid #e9ecf4;
}

.eh-toolbar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  justify-content: center;
  font-size: 22rpx;
  color: var(--app-ink);
}

.eh-toolbar-on {
  color: var(--app-accent);
}

.eh-tb-ico {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.eh-overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(20, 28, 48, 0.36);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.eh-sheet,
.eh-preview-sheet {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
  border-radius: 36rpx 36rpx 0 0;
}

.eh-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.eh-sheet-opt {
  margin-bottom: 16rpx;
}

.eh-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.eh-preview-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.eh-preview-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.eh-preview-back {
  color: var(--app-accent);
  font-size: 26rpx;
  flex: none;
}

.eh-preview-ok {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--app-ink-2);
}

.eh-links-panel {
  padding-top: 24rpx;
}

.eh-back {
  color: var(--app-accent);
  font-size: 28rpx;
}

.eh-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.eh-status {
  text-align: right;
  font-size: 20rpx;
  color: var(--app-muted);
}

.eh-state {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  color: var(--app-muted);
  line-height: 1.5;
  text-align: center;
}

.eh-slug {
  margin-top: 24rpx;
}

.eh-kicker {
  font-size: 22rpx;
  color: var(--app-muted);
  letter-spacing: 0.08em;
}

.eh-lead {
  margin: 12rpx 0 32rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--app-ink-2);
}

.eh-portrait-block {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.eh-portrait-ring {
  position: relative;
  flex: none;
}

.eh-portrait {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  display: block;
  background: var(--app-accent-wash);
}

.eh-portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 600;
  color: var(--app-accent);
  text-transform: uppercase;
}

.eh-portrait-badge {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  border: 4rpx solid var(--app-bg);
  background: var(--app-accent);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eh-portrait-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eh-portrait-title {
  font-size: 30rpx;
  font-weight: 600;
}

.eh-portrait-hint {
  font-size: 22rpx;
  color: var(--app-muted);
  line-height: 1.45;
}

.eh-card {
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  border-radius: 32rpx;
  padding: 8rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
}

.eh-field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--app-line);
}

.eh-field-last {
  border-bottom: none;
}

.eh-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.eh-input,
.eh-textarea {
  width: 100%;
  min-height: 48rpx;
  font-size: 28rpx;
  color: var(--app-ink);
  background: transparent;
}

.eh-textarea {
  min-height: 120rpx;
  line-height: 1.45;
}

.eh-section-label {
  margin: 12rpx 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--app-muted);
  letter-spacing: 0.06em;
}

.eh-skins {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.eh-skin {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  font-size: 24rpx;
}

.eh-skin-on {
  border-color: var(--app-accent);
  background: var(--app-accent-wash);
}

.eh-skin-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.eh-social {
  display: grid;
  grid-template-columns: 180rpx 1fr 56rpx;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--app-line);
}

.eh-social-kind {
  font-size: 26rpx;
  color: var(--app-ink-2);
}

.eh-social-url {
  min-width: 0;
}

.eh-remove {
  color: #c45b5b;
  font-size: 24rpx;
  text-align: right;
}

.eh-section-card {
  margin-bottom: 20rpx;
}

.eh-section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 12rpx;
}

.eh-section-type {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--app-accent);
  background: rgba(47, 109, 244, 0.1);
}

.eh-section-title {
  flex: 1;
  font-weight: 600;
  min-width: 0;
}

.eh-item-field-label {
  font-size: 22rpx;
  color: var(--app-muted);
}

.eh-section-tools {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--app-muted);
}

.eh-item {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--app-line);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.eh-btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.eh-btn::after {
  border: none;
}

.eh-btn-primary {
  margin-top: 8rpx;
  background: var(--app-grad);
  color: #fff;
}

.eh-btn-primary[disabled] {
  opacity: 0.55;
}

.eh-btn-secondary {
  background: var(--app-card);
  color: var(--app-ink);
  border: 1rpx solid var(--app-line);
}

.eh-btn-ghost {
  margin-top: 8rpx;
  background: transparent;
  color: var(--app-accent);
  font-size: 26rpx;
  line-height: 2;
}

.eh-btn-inline {
  flex: none;
  padding: 0 28rpx;
  line-height: 2;
  font-size: 24rpx;
}

.eh-add-section {
  margin-bottom: 16rpx;
}

.eh-error {
  margin: 8rpx 0 16rpx;
  color: #c45b5b;
  font-size: 24rpx;
  line-height: 1.45;
}

.eh-feedback {
  margin: 8rpx 0 16rpx;
  color: var(--app-ink-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.eh-share-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.eh-share-url {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eh-display-pick {
  margin-top: 12rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--app-accent);
}

/* SHARE / 发布底栏样式见文末 .eh-editor 对齐块 */

.eh-btn-publish {
  width: 100%;
  margin: 0;
  padding: 30rpx 36rpx;
  border-radius: 32rpx;
  background: var(--app-grad);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.eh-btn-publish::after {
  border: none;
}

.eh-btn-publish[disabled] {
  opacity: 0.5;
}

.eh-publish-label {
  flex: 1;
  min-width: 0;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eh-publish-arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 1;
}

.eh-studio-hint {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--app-muted);
}

.eh-overlay-center {
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.eh-share-picker {
  width: 100%;
  max-width: 840rpx;
  max-height: calc(100vh - 64rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 48rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 40rpx;
  background: #fff;
  color: #20232b;
}

.eh-share-picker-title {
  display: block;
  margin: 0 0 16rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.eh-share-picker-note {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #657080;
  line-height: 1.5;
}

.eh-share-picker-option {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 28rpx 0;
  border-top: 1rpx solid #edf0f3;
}

.eh-share-picker-option-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 30rpx;
  color: #20232b;
}

.eh-share-picker-url {
  font-size: 24rpx;
  color: #657080;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.eh-share-picker-status {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #657080;
}

.eh-share-picker-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 36rpx;
}

.eh-share-picker-cancel,
.eh-share-picker-send {
  margin: 0;
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.eh-share-picker-cancel {
  background: #fff;
  color: #20232b;
  border: 1rpx solid #d9dee5;
}

.eh-share-picker-send {
  background: #254ee8;
  color: #fff;
  border: 1rpx solid #254ee8;
}

.eh-share-picker-cancel::after,
.eh-share-picker-send::after {
  border: none;
}

.eh-share-picker-cancel[disabled],
.eh-share-picker-send[disabled] {
  opacity: 0.5;
}
/* ===== 添加内容目录（对齐 AddContentSheet / ContentCatalogPicker） ===== */
.eh-overlay-sheet {
  align-items: flex-end;
}

.eh-acs {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  color: var(--app-ink);
}

.eh-acs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eh-acs-title {
  font-size: 40rpx;
  font-weight: 700;
}

.eh-acs-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f4f5f8;
  color: var(--app-muted);
  font-size: 40rpx;
  line-height: 68rpx;
  text-align: center;
}

.eh-acs-search {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.eh-acs-search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f4f5f8;
  font-size: 28rpx;
}

.eh-acs-paste-btn {
  flex: none;
  margin: 0;
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  background: #edf2ff;
  color: var(--app-accent);
  font-size: 24rpx;
  font-weight: 600;
}

.eh-acs-paste-btn::after {
  border: none;
}

.eh-acs-pills {
  white-space: nowrap;
  margin-bottom: 16rpx;
  width: 100%;
  padding: 8rpx 0 12rpx;
}

.eh-acs-pill {
  display: inline-block;
  margin-right: 16rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f4f5f8;
  color: var(--app-muted);
  font-size: 26rpx;
}

.eh-acs-pill-on {
  background: #eaf0ff;
  color: var(--app-accent);
  font-weight: 600;
}

.eh-acs-works {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
