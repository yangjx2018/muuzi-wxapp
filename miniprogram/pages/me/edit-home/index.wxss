.eh-field-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.eh-field-box .eh-label {
  display: block;
  margin: 0;
  font-size: 24rpx;
  letter-spacing: 0;
  color: var(--app-muted);
}

.eh-control {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--app-line);
  background: var(--app-bg);
  font-size: 28rpx;
  color: var(--app-ink);
  line-height: 1.4;
}

.eh-control-area {
  min-height: 160rpx;
  line-height: 1.5;
}

.eh-picker-value {
  display: flex;
  align-items: center;
}

.eh-profile-section {
  /* inherits .eh-section */
}

.eh-profile-editor .eh-section {
  border-radius: 44rpx;
}

/* App .profileEditor .portrait: 76px circle */
.eh-profile-editor .eh-portrait-box {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}

.eh-profile-editor .eh-control {
  font-size: 32rpx;
}

.eh-coop {
  margin: 12rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.eh-coop-intro {
  padding: 28rpx 48rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.eh-coop-h2 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--app-ink);
  line-height: 1.3;
}

.eh-coop-lead {
  font-size: 26rpx;
  color: var(--app-muted);
  line-height: 1.5;
}

.eh-coop-card {
  /* inherits .eh-section */
}

.eh-coop-h3 {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
}

.eh-coop-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.eh-coop-count {
  font-size: 22rpx;
  color: var(--app-muted);
}

.eh-coop-empty {
  margin: 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--app-bg);
  color: var(--app-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.eh-lang-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.eh-lang-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--app-bg);
  border: 1rpx solid var(--app-line);
  font-size: 24rpx;
  color: var(--app-muted);
}

.eh-lang-chip-on {
  background: var(--app-accent-wash);
  border-color: var(--app-accent);
  color: var(--app-accent);
  font-weight: 600;
}

.eh-offer-item {
  padding: 8rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-top: 1rpx solid var(--app-line);
}

.eh-offer-pair {
  display: flex;
  gap: 16rpx;
}

.eh-offer-half {
  flex: 1;
  min-width: 0;
}

.eh-offer-note {
  font-size: 20rpx;
  color: var(--app-muted);
  line-height: 1.45;
}

/* App .editor .socialRow */
.eh-social-editor-row {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr) 68rpx;
  gap: 16rpx;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid var(--app-line);
  border-radius: 32rpx;
  box-sizing: border-box;
}

.eh-social-editor-row .eh-control {
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.eh-social-kind {
  font-size: 26rpx;
}

.eh-social-url {
  min-width: 0;
}

.eh-sections-head {
  padding-bottom: 8rpx;
  margin-bottom: 0;
}

.eh-block-card {
  gap: 16rpx;
}

.eh-section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.eh-section-type {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--app-accent);
  background: var(--app-accent-wash);
}

.eh-section-title {
  flex: 1;
  font-weight: 600;
  min-width: 0;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
}

.eh-item-field-label {
  font-size: 21rpx;
  color: var(--app-faint);
}

.eh-section-tools {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--app-muted);
}

.eh-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: var(--app-bg);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.eh-add-section {
  margin: 28rpx 32rpx 0;
  align-self: stretch;
  text-align: center;
}

.eh-preview-draft-row {
  margin: 28rpx 32rpx 0;
  display: flex;
  flex-direction: row;
}

.eh-preview-draft-row .eh-ghost {
  flex: 1;
  align-self: stretch;
}

.eh-address-topline {
  font-size: 24rpx;
  color: var(--app-muted);
  line-height: 1.4;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.eh-share-section {
  /* inherits .eh-section */
}

.eh-share-grid-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.eh-short-code {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-line);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--app-ink);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eh-share-hint-text {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--app-muted);
}

.eh-publish-foot {
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.eh-avatar-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 200px;
  height: 200px;
}

/* Keep legacy list portrait helpers for linksOnly panel */
.eh-portrait-block {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.eh-portrait-ring {
  position: relative;
  flex: none;
}

.eh-portrait-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eh-portrait-title {
  font-size: 30rpx;
  font-weight: 600;
}

.eh-portrait-hint {
  font-size: 22rpx;
  color: var(--app-muted);
  line-height: 1.45;
}

.eh-portrait-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

