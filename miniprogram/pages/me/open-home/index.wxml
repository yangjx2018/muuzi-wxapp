<app-banner section="主页" show-back fallback-url="/pages/me/index" fallback-tab="{{true}}" />

<!-- 仅业务域名白名单命中时挂 web-view；否则永不挂载，避免微信「无法打开该页面」 -->
<web-view
  wx:if="{{embedAllowed && homeUrl}}"
  src="{{homeUrl}}"
  binderror="onWebViewError"
></web-view>

<scroll-view wx:else scroll-y class="oh-page" enhanced show-scrollbar="{{false}}">
  <view wx:if="{{loading}}" class="oh-loading">正在打开成品主页…</view>

  <block wx:else>
    <view wx:if="{{error}}" class="oh-card">
      <view class="oh-eyebrow">SHARE · 成品</view>
      <view class="oh-title">{{error}}</view>
      <view class="oh-hint">{{hint}}</view>
      <button
        wx:if="{{fallbackUrl}}"
        class="oh-btn"
        bindtap="copyFallback"
      >复制主页链接</button>
    </view>

    <block wx:else>
      <!-- 与编辑预览共用 home-page-preview，按发布配置所见即所得 -->
      <home-page-preview
        wx:if="{{previewReady && previewModel}}"
        model="{{previewModel}}"
        share-open-type="{{true}}"
        audio-playing-key="{{audioPlayingKey}}"
        bind:share="onShareTap"
        bind:openitem="onPreviewOpenItem"
        bind:audiotap="onPreviewAudioTap"
      />

      <view class="oh-copy-bar">
        <view wx:if="{{fallbackDisplay || fallbackUrl}}" class="oh-url">{{fallbackDisplay || fallbackUrl}}</view>
        <view class="oh-hint">
          {{hint || '条目点击打开或播放；也可复制主页链接到浏览器（与 App「看成品」同一地址）。'}}
        </view>
        <view wx:if="{{copied}}" class="oh-copied" role="status">主页链接已复制</view>
        <button
          wx:if="{{fallbackUrl}}"
          class="oh-btn"
          bindtap="copyFallback"
        >复制主页链接</button>
      </view>
    </block>
  </block>
</scroll-view>
