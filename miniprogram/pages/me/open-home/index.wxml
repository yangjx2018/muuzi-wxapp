<app-banner section="主页" show-back fallback-url="/pages/me/index" fallback-tab="{{true}}" />

<!-- 仅业务域名白名单命中时挂 web-view；否则永不挂载，避免微信「无法打开该页面」 -->
<web-view
  wx:if="{{embedAllowed && homeUrl}}"
  src="{{homeUrl}}"
  binderror="onWebViewError"
></web-view>

<scroll-view wx:else scroll-y class="oh-page" enhanced show-scrollbar="{{false}}">
  <view wx:if="{{loading}}" class="oh-loading">正在打开成品主页…</view>

  <block wx:else>
    <view wx:if="{{error}}" class="oh-card">
      <view class="oh-eyebrow">SHARE · 成品</view>
      <view class="oh-title">{{error}}</view>
      <view class="oh-hint">{{hint}}</view>
      <button
        wx:if="{{fallbackUrl}}"
        class="oh-btn"
        bindtap="copyFallback"
      >复制主页链接</button>
    </view>

    <block wx:else>
      <!-- 对齐 App「看成品」公开页 hero-profile · docs/OPEN_HOME_APP_PARITY.md -->
      <view wx:if="{{previewReady}}" class="oh-preview">
        <view class="oh-preview-tools">
          <view
            wx:if="{{previewShowBranding}}"
            class="oh-preview-brand"
            aria-label="MuuZi"
          >
            <image
              class="oh-preview-brand-img"
              src="/assets/logo-muu.png"
              mode="aspectFit"
              aria-hidden="true"
            />
          </view>
          <view wx:else class="oh-preview-tools-spacer"></view>
          <button
            class="oh-preview-share"
            open-type="share"
            bindtap="onShareTap"
            aria-label="分享主页"
            hover-class="oh-preview-share-hover"
          >
            <image
              class="oh-preview-share-img"
              src="/assets/icon-share-out.png"
              mode="aspectFit"
              aria-hidden="true"
            />
          </button>
        </view>

        <view class="oh-preview-cover" aria-hidden="true">
          <view class="oh-preview-panel oh-preview-panel-a"></view>
          <view class="oh-preview-panel oh-preview-panel-b"></view>
          <view class="oh-preview-panel oh-preview-panel-c"></view>
        </view>

        <view class="oh-preview-hero">
          <view class="oh-preview-avatar">
            <image
              wx:if="{{previewPortrait}}"
              class="oh-preview-avatar-img"
              src="{{previewPortrait}}"
              mode="aspectFill"
            />
            <view wx:else class="oh-preview-avatar-img oh-portrait-fallback">{{previewLetter}}</view>
          </view>
          <text class="oh-preview-name">{{previewName}}</text>
          <text wx:if="{{previewHeadline}}" class="oh-preview-bio">{{previewHeadline}}</text>
          <text wx:elif="{{previewBio}}" class="oh-preview-bio">{{previewBio}}</text>
          <view wx:if="{{previewSocials.length}}" class="oh-preview-socials">
            <view
              wx:for="{{previewSocials}}"
              wx:key="kind"
              class="oh-preview-social"
              data-url="{{item.url}}"
              data-title="{{item.label}}"
              bindtap="openLink"
              aria-label="{{item.label}}"
            >
              <image
                class="oh-preview-social-img"
                src="{{item.icon}}"
                mode="aspectFit"
                aria-hidden="true"
              />
            </view>
          </view>
        </view>

        <block wx:for="{{previewSections}}" wx:key="id" wx:for-item="section">
          <view wx:if="{{section.items.length}}" class="oh-preview-section">
            <text wx:if="{{section.title}}" class="oh-preview-section-title">{{section.title}}</text>

            <!-- 店铺：双列商品卡 · 对齐 App .shop-grid -->
            <view wx:if="{{section.type === 'shop'}}" class="oh-shop-grid">
              <view
                wx:for="{{section.items}}"
                wx:for-item="item"
                wx:key="key"
                class="oh-product"
                data-url="{{item.url}}"
                data-title="{{item.title}}"
                data-note="{{item.note}}"
                bindtap="openLink"
              >
                <view class="oh-product-img">
                  <image
                    wx:if="{{item.image_url}}"
                    class="oh-product-img-el"
                    src="{{item.image_url}}"
                    mode="aspectFill"
                  />
                  <text wx:else class="oh-product-ph">商品</text>
                </view>
                <view class="oh-product-body">
                  <text class="oh-product-title">{{item.title}}</text>
                  <text wx:if="{{item.note}}" class="oh-product-note">{{item.note}}</text>
                  <view class="oh-product-price">
                    <text>{{item.price_text || '询价'}}</text>
                    <text wx:if="{{item.link_kind !== 'store'}}" class="oh-product-buy">购买 →</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 音频：对齐 App AudioPlayer / SSR track -->
            <block wx:elif="{{section.type === 'audio'}}">
              <view
                wx:for="{{section.items}}"
                wx:for-item="item"
                wx:key="key"
                class="oh-audio-card {{audioPlayingKey === item.key ? 'oh-audio-playing' : ''}}"
                data-key="{{item.key}}"
                data-url="{{item.url}}"
                data-title="{{item.title}}"
                data-direct="{{item.directAudio}}"
                data-note="{{item.note}}"
                bindtap="onAudioTap"
              >
                <view class="oh-audio-play">{{audioPlayingKey === item.key ? '❚❚' : '▶'}}</view>
                <view class="oh-audio-body">
                  <text class="oh-audio-title">{{item.title}}</text>
                  <text class="oh-audio-meta">
                    {{item.directAudio ? (audioPlayingKey === item.key ? '播放中 · 再点暂停' : '点击播放') : '打开试听页'}}
                    <text wx:if="{{item.duration}}"> · {{item.duration}}</text>
                  </text>
                </view>
              </view>
            </block>

            <!-- 自定义笔记卡：正文页内可见 · 对齐 App .note-card -->
            <block wx:elif="{{section.type === 'custom'}}">
              <view
                wx:for="{{section.items}}"
                wx:for-item="item"
                wx:key="key"
                class="oh-note-card"
              >
                <image
                  wx:if="{{item.image_url}}"
                  class="oh-note-img"
                  src="{{item.image_url}}"
                  mode="widthFix"
                />
                <text class="oh-note-title">{{item.title}}</text>
                <text wx:if="{{item.body || item.note}}" class="oh-note-body">{{item.body || item.note}}</text>
                <view
                  wx:if="{{item.hasUrl}}"
                  class="oh-note-cta"
                  data-url="{{item.url}}"
                  data-title="{{item.title}}"
                  data-note="{{item.note}}"
                  bindtap="openLink"
                >{{item.link_label || '打开'}} →</view>
              </view>
            </block>

            <!-- 视频：封面卡 · 对齐 App film -->
            <block wx:elif="{{section.type === 'video'}}">
              <view
                wx:for="{{section.items}}"
                wx:for-item="item"
                wx:key="key"
                class="oh-video-card"
                data-url="{{item.url}}"
                data-title="{{item.title}}"
                bindtap="openLink"
              >
                <view class="oh-video-cover">
                  <image
                    wx:if="{{item.cover_url || item.image_url}}"
                    class="oh-video-cover-img"
                    src="{{item.cover_url || item.image_url}}"
                    mode="aspectFill"
                  />
                  <view class="oh-video-play">▶</view>
                </view>
                <text class="oh-video-title">{{item.title}}</text>
              </view>
            </block>

            <!-- 默认 links / agents / skills：链接卡 · 点击打开 -->
            <block wx:else>
              <view
                wx:for="{{section.items}}"
                wx:for-item="item"
                wx:key="key"
                class="oh-preview-link-card"
                data-url="{{item.url}}"
                data-title="{{item.label || item.title}}"
                data-note="{{item.note}}"
                bindtap="openLink"
              >
                <image
                  wx:if="{{item.image_url}}"
                  class="oh-link-thumb"
                  src="{{item.image_url}}"
                  mode="aspectFill"
                />
                <view class="oh-preview-link-text">
                  <text class="oh-preview-link-label">{{item.label || item.title}}</text>
                  <text wx:if="{{item.note}}" class="oh-preview-link-note">{{item.note}}</text>
                </view>
                <text class="oh-preview-link-arrow">↗</text>
              </view>
            </block>
          </view>
        </block>

        <view class="oh-preview-footer">
          <view
            wx:if="{{previewShowBranding}}"
            class="oh-preview-join"
          >在 MuuZi 上加入 {{previewName}}</view>
          <view class="oh-preview-legal">条款 · 举报 · 隐私</view>
          <view
            wx:if="{{previewShowBranding}}"
            class="oh-preview-more"
          >来自 MuuZi 的更多内容</view>
        </view>
      </view>

      <view class="oh-copy-bar">
        <view wx:if="{{fallbackDisplay || fallbackUrl}}" class="oh-url">{{fallbackDisplay || fallbackUrl}}</view>
        <view class="oh-hint">
          {{hint || '条目点击打开或播放；也可复制主页链接到浏览器（与 App「看成品」同一地址）。'}}
        </view>
        <view wx:if="{{copied}}" class="oh-copied" role="status">主页链接已复制</view>
        <button
          wx:if="{{fallbackUrl}}"
          class="oh-btn"
          bindtap="copyFallback"
        >复制主页链接</button>
      </view>
    </block>
  </block>
</scroll-view>
