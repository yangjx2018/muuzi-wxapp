/* 对齐 App EditHome / ProfileShare「打开主页」回退壳：卡片 + ghost/primary 语言 */
.oh-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg, #f4f5f8);
}

.oh-loading {
  font-size: 26rpx;
  color: var(--app-muted, #666c80);
  line-height: 1.5;
  padding: 32rpx 8rpx;
}

.oh-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin: 0;
  padding: 40rpx 32rpx;
  background: var(--app-card, #ffffff);
  border-radius: 40rpx;
  box-sizing: border-box;
}

.oh-eyebrow {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(21, 23, 30, 0.45);
  margin-bottom: -12rpx;
}

.oh-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--app-ink, #15171e);
  line-height: 1.35;
}

.oh-url {
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--app-card, #ffffff);
  border: 1rpx solid var(--app-line, rgba(21, 23, 30, 0.08));
  font-size: 26rpx;
  color: var(--app-ink, #15171e);
  line-height: 1.5;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.oh-hint {
  font-size: 24rpx;
  color: var(--app-muted, #666c80);
  line-height: 1.55;
}

.oh-btn {
  width: 100%;
  margin: 0;
  padding: 28rpx 36rpx;
  border-radius: 32rpx;
  background: var(--app-grad, linear-gradient(160deg, #6a99fe, #2f6df4));
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
  box-sizing: border-box;
}

.oh-btn::after {
  border: none;
}
