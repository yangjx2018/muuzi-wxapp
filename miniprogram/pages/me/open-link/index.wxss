.ol-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 80rpx;
  background: #f4f5f8;
}

.ol-card {
  margin-top: 24rpx;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(21, 23, 30, 0.06);
}

.ol-eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #8b929c;
  margin-bottom: 16rpx;
}

.ol-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #20232b;
  line-height: 1.35;
}

.ol-note {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #69717b;
  white-space: pre-wrap;
}

.ol-url {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f4f6fa;
  font-size: 24rpx;
  color: #316bfa;
  word-break: break-all;
  line-height: 1.45;
}

.ol-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8b929c;
}

.ol-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #eef2fb;
  color: #316bfa;
  border: 0;
  padding: 0;
}

.ol-btn::after {
  border: none;
}

.ol-btn-primary {
  background: #316bfa;
  color: #fff;
}
