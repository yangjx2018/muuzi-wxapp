@import "../_page.wxss";

/**
 * 我的店铺 · 对齐 App StorefrontSettingsScreen.module.css
 * 输入：灰底 app-bg + hairline 边 + 12px 圆角（样式落在外壳，避免原生 input 丢圆角）
 * 勾选：圆形蓝底勾（对齐 App WebView checkbox）
 */

.mp-header {
  display: block;
  padding: 8rpx 0 16rpx;
}

.mp-title {
  text-align: left;
  font-size: 40rpx;
  font-weight: 600;
}

.mp-card {
  padding: 40rpx;
  margin-bottom: 24rpx;
  border: none;
  border-radius: 44rpx;
  background: var(--app-card);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.mp-card .mp-h2 {
  margin: 0;
  font-size: 32rpx;
}

.mp-card > .mp-lead {
  margin: 0;
  font-size: 26rpx;
  line-height: 1.7;
}

.mp-field {
  padding: 0;
  border-bottom: none;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mp-label {
  margin-bottom: 0;
  font-size: 24rpx;
  color: var(--app-muted);
}

/* App: background var(--app-bg); border 1px hairline; radius 12px; padding 12px */
.mp-input,
.mp-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--app-ink);
  background: var(--app-bg);
  border: 1rpx solid rgba(21, 23, 30, 0.06);
  border-radius: 24rpx;
}

.mp-textarea {
  min-height: 180rpx;
}

.mp-input-readonly {
  display: block;
  word-break: break-all;
}

/* native control inside gray shell */
.mp-control {
  display: block;
  width: 100%;
  min-height: 40rpx;
  padding: 0;
  margin: 0;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--app-ink);
  background: transparent;
  border: none;
}

.mp-control-area {
  width: 100%;
  min-height: 132rpx;
}

.mp-input.is-disabled,
.mp-textarea.is-disabled {
  opacity: 0.55;
}

.mp-badge {
  display: inline-block;
  margin: 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--app-accent);
  background: var(--app-accent-wash);
  align-self: flex-start;
}

/* App checkbox · circular blue when on */
.mp-check {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid #c3c7d3;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mp-check.on {
  border-color: var(--app-accent);
  background: var(--app-accent);
}

.mp-check.disabled {
  opacity: 0.45;
}

.mp-check-tick {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.mp-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0;
}

.mp-toggle.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.mp-toggle-label {
  flex: 1;
  min-width: 0;
  max-width: 85%;
  font-size: 28rpx;
  color: var(--app-ink);
  line-height: 1.6;
}

.mp-link {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--app-accent);
}

.mp-product {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--app-line);
}

.mp-product:last-child {
  border-bottom: none;
}

.mp-product-body {
  flex: 1;
  min-width: 0;
}

.mp-product-kind {
  display: inline-block;
  margin-bottom: 6rpx;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--app-accent);
  background: var(--app-accent-wash);
}

.mp-product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-ink);
  overflow-wrap: anywhere;
}

.mp-product-body > .mp-lead {
  margin: 8rpx 0 0;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mp-muted {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.mp-paging {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 0;
  font-size: 24rpx;
}

.mp-row-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 12rpx;
}

.mp-btn-primary {
  background: var(--app-accent);
  border-radius: 32rpx;
  padding: 8rpx 0;
}
