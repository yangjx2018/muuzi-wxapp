<view
  class="msg-chrome"
  style="padding-top: {{statusBarPx}}px;"
>
  <view
    class="msg-topbar"
    style="height: {{navBarPx}}px; padding-right: {{capsuleGapPx}}px;"
  >
    <view class="msg-launcher" bindtap="onOpenDrawer" hover-class="msg-launcher-hover">
      <image
        class="msg-launcher-people-img"
        src="/assets/icon-ui-nav-people-accent.png"
        mode="aspectFit"
      />
      <text class="msg-launcher-label">工作区</text>
      <text class="msg-launcher-current">{{workspaceTitle}}</text>
      <image
        class="msg-launcher-chevron"
        src="/assets/icon-ui-chevron-muted.png"
        mode="aspectFit"
      />
    </view>
    <view class="msg-top-actions">
      <view class="msg-icon-hit" bindtap="onToggleSearch" aria-role="button">
        <image class="msg-ico-img" src="/assets/icon-ui-search-ink.png" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="msg-icon-hit" bindtap="onOpenNew" aria-role="button">
        <image class="msg-ico-img" src="/assets/icon-ui-plus-ink.png" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
  </view>
</view>

<view class="msg-page" style="padding-top: {{bannerPadPx}}px;">
  <!-- 不用无高度 scroll-view：微信下会塌缩并盖住下方圆形工作区图标 -->
  <view class="msg-rail">
    <view
      wx:for="{{workspaceRail}}"
      wx:key="key"
      class="msg-rail-item {{workspace === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickWorkspace"
    >
      <view class="msg-rail-dot {{item.tone}}">
        <view wx:if="{{item.chatIco}}" class="msg-rail-chat-ico" aria-hidden="true"></view>
        <image
          wx:elif="{{item.icon && item.tone === 'muu'}}"
          class="msg-rail-img fill"
          src="{{item.icon}}"
          mode="aspectFill"
        />
        <image
          wx:elif="{{item.icon}}"
          class="msg-rail-img"
          src="{{item.icon}}"
          mode="aspectFit"
        />
        <text wx:else>{{item.glyph}}</text>
      </view>
      <text class="msg-rail-label">{{item.label}}</text>
    </view>
  </view>

  <view class="msg-tools">
    <picker
      mode="selector"
      range="{{roomTypeLabels}}"
      value="{{roomTypeIndex}}"
      bindchange="onRoomTypePick"
    >
      <view class="msg-type-filter {{roomType !== 'all' ? 'active' : ''}}">
        <image class="msg-ico-img" src="/assets/icon-ui-menu-ink.png" mode="aspectFit" aria-hidden="true" />
      </view>
    </picker>
    <view class="msg-tabs">
      <view
        class="msg-tab {{inboxFilter === 'all' ? 'on' : ''}}"
        data-key="all"
        bindtap="onFilter"
      >消息</view>
      <view
        class="msg-tab {{inboxFilter === 'unread' ? 'on' : ''}}"
        data-key="unread"
        bindtap="onFilter"
      >未读</view>
      <view
        class="msg-tab {{inboxFilter === 'mentions' ? 'on' : ''}}"
        data-key="mentions"
        bindtap="onFilter"
      >@我</view>
    </view>
  </view>

  <view wx:if="{{!ready && !error}}" class="msg-sync">正在同步节点对话…</view>
  <view wx:if="{{error}}" class="msg-sync err">{{error}}</view>
  <view wx:if="{{ready && workspaceError}}" class="msg-sync err">
    {{workspaceError}}
    <text class="msg-link" bindtap="onRetryWorkspaces">重试</text>
  </view>

  <view wx:if="{{error && !ready && !roomCount}}" class="msg-actions">
    <button class="msg-btn" bindtap="onRetry">重试同步</button>
    <button class="msg-btn ghost" bindtap="onRelogin">重新登录</button>
  </view>
  <view wx:elif="{{error && !ready && roomCount}}" class="msg-actions">
    <button class="msg-btn" bindtap="onRetry">重试同步</button>
  </view>

  <view wx:if="{{showSearch}}" class="msg-search-field">
    <image
      class="msg-search-field-ico"
      src="/assets/icon-ui-search-ink.png"
      mode="aspectFit"
      aria-hidden="true"
    />
    <input
      class="msg-search-field-input"
      placeholder="搜索已同步会话"
      placeholder-class="msg-input-ph"
      value="{{search}}"
      bindinput="onSearchInput"
      confirm-type="search"
      focus
    />
  </view>

  <view wx:if="{{inboxFilter === 'mentions'}}" class="msg-note">
    显示已同步消息中明确提到你的会话。
  </view>

  <view wx:if="{{inviteCount}}" class="msg-section">
    <view class="msg-section-title">对话邀请</view>
    <block wx:for="{{invitations}}" wx:key="roomId">
      <view class="msg-row">
        <view
          class="msg-row-hit"
          catchtap="onOpenRoom"
          data-index="{{index}}"
          data-source="invite"
          data-room-id="{{item.roomId}}"
        >
          <view class="msg-tile {{item.tileClass}}">
            <image wx:if="{{item.avatarSrc}}" class="msg-tile-img" src="{{item.avatarSrc}}" mode="aspectFill" />
            <text wx:else>{{item.glyph}}</text>
          </view>
          <view class="msg-row-main">
            <view class="msg-row-head">
              <text class="msg-row-name">{{item.name}}</text>
            </view>
            <view class="msg-row-preview">{{item.previewLine}}</view>
          </view>
        </view>
        <view class="msg-invite-actions">
          <view
            class="msg-mini-btn"
            data-room-id="{{item.roomId}}"
            bindtap="onAcceptInvite"
          >{{inviteBusyId === item.roomId ? '…' : '接受'}}</view>
          <view
            class="msg-mini-btn ghost"
            data-room-id="{{item.roomId}}"
            bindtap="onDeclineInvite"
          >拒绝</view>
        </view>
      </view>
    </block>
  </view>

  <view
    wx:if="{{emptyAiCount && (workspace === 'all' || workspace === 'muu')}}"
    class="msg-empty-ai"
    bindtap="onToggleEmptyAi"
  >{{showEmptyAi ? '收起未开始的会话' : '未开始的 Muu 会话（' + emptyAiCount + '）'}}</view>

  <view wx:if="{{visibleCount}}" class="msg-list">
    <block wx:for="{{visibleRooms}}" wx:key="roomId">
      <view class="msg-row">
        <view
          class="msg-row-hit"
          catchtap="onOpenRoom"
          data-index="{{index}}"
          data-source="inbox"
          data-room-id="{{item.roomId}}"
        >
          <view class="msg-tile {{item.tileClass}}">
            <image wx:if="{{item.avatarSrc}}" class="msg-tile-img" src="{{item.avatarSrc}}" mode="aspectFill" />
            <text wx:else>{{item.glyph}}</text>
          </view>
          <view class="msg-row-main">
            <view class="msg-row-head">
              <text class="msg-row-name">{{item.name}}</text>
              <text wx:if="{{item.timeLabel}}" class="msg-row-time">{{item.timeLabel}}</text>
            </view>
            <view class="msg-row-preview">{{item.previewLine}}</view>
          </view>
          <view wx:if="{{item.unreadLabel}}" class="msg-badge">{{item.unreadLabel}}</view>
        </view>
        <view
          wx:if="{{item.isAi}}"
          class="msg-row-more"
          data-room-id="{{item.roomId}}"
          data-name="{{item.name}}"
          bindtap="onAiMore"
        >⋯</view>
      </view>
    </block>
  </view>

  <view wx:if="{{filteredEmpty}}" class="msg-empty">
    <view class="msg-empty-title">当前筛选下没有对话。</view>
    <view class="msg-empty-lead">共有 {{roomCount}} 个会话被工作区或筛选条件隐藏。</view>
    <view class="msg-link-reset" bindtap="onResetFilters">查看全部消息</view>
  </view>
  <view wx:elif="{{empty && !error && ready}}" class="msg-empty">
    <view class="msg-empty-title">这里暂时没有对话。</view>
    <view class="msg-empty-lead">可切换工作区或筛选条件；不会伪造房间。</view>
  </view>

  <view wx:if="{{drawerOpen}}" class="msg-drawer-mask" bindtap="onCloseDrawer">
    <view class="msg-drawer" catchtap="noop">
      <view class="msg-drawer-brand">
        <image class="msg-drawer-logo" src="/assets/logo-muu.png" mode="aspectFit" />
        <view>
          <view class="msg-drawer-title">工作区</view>
          <view class="msg-drawer-sub">让每一段交流，各有归处</view>
        </view>
      </view>
      <block wx:for="{{workspaceChoices}}" wx:key="key">
        <view
          class="msg-drawer-item {{item.current ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickWorkspace"
        >
          <view class="msg-drawer-copy">
            <text class="msg-drawer-name">{{item.name}}</text>
            <text class="msg-drawer-desc">{{item.description}}</text>
          </view>
          <text class="msg-drawer-count">{{item.count}}</text>
        </view>
      </block>
      <view class="msg-drawer-foot">保存在你的节点，仅你可见</view>
      <view class="msg-drawer-close" bindtap="onCloseDrawer">关闭</view>
    </view>
  </view>

  <view wx:if="{{showNew}}" class="msg-drawer-mask sheet" bindtap="onCloseNew">
    <view class="msg-sheet" catchtap="noop">
      <view class="msg-drawer-title">发起私信</view>
      <view class="msg-sheet-field">
        <input
          class="msg-sheet-input"
          placeholder="用户名或 @name:node.example"
          placeholder-class="msg-input-ph"
          value="{{peerDraft}}"
          bindinput="onPeerInput"
          maxlength="255"
        />
      </view>
      <view class="msg-sheet-hint">同节点可填用户名，跨节点请填完整账号。已有对话会直接打开。</view>
      <view wx:if="{{dmError}}" class="msg-sheet-error">{{dmError}}</view>
      <view class="msg-actions msg-sheet-actions">
        <button class="msg-btn ghost" bindtap="onCloseNew" disabled="{{dmBusy}}">取消</button>
        <button class="msg-btn" bindtap="onCreateDm" loading="{{dmBusy}}">发起私信</button>
      </view>
    </view>
  </view>
</view>
