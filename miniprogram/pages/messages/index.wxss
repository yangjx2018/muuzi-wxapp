/* Messages · 对齐 App MessagesScreen 收件箱布局 */

/* 对齐 App messagesHeader：固定在顶栏区，不压住下方工作区轨道 */
.msg-chrome {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #ffffff;
  box-sizing: border-box;
}

.msg-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.msg-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
}

/* 对齐 App：内容自适应宽度的小胶囊，禁止拉满整行 */
.msg-launcher {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 1 auto;
  width: auto;
  max-width: 58%;
  min-height: 64rpx;
  padding: 10rpx 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid var(--app-line, #e6e8ee);
  box-sizing: border-box;
}

.msg-launcher-hover {
  opacity: 0.92;
}

.msg-launcher-people-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.msg-launcher-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--app-accent);
  flex-shrink: 0;
  line-height: 1.2;
}

.msg-launcher-current {
  font-size: 18rpx;
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  max-width: 160rpx;
  line-height: 1.2;
}

.msg-launcher-chevron {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  opacity: 0.55;
  transform: none;
}

.msg-top-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.msg-icon-hit {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-ico-img {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

/* 横向轨道：普通 view + overflow，避免无高度 scroll-view 塌缩盖住图标 */
.msg-rail {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 20rpx 24rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.msg-rail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 116rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.msg-rail-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  box-sizing: border-box;
  overflow: hidden;
}

.msg-rail-img {
  width: 40rpx;
  height: 40rpx;
}

.msg-rail-img.fill {
  width: 100%;
  height: 100%;
}

/* 全部消息：浅蓝底 + 蓝色线框气泡（对齐 App navChat，禁止黑实心 PNG） */
.msg-rail-dot.wash {
  background: #eaf0ff;
  color: var(--app-accent);
}

.msg-rail-chat-ico {
  width: 40rpx;
  height: 36rpx;
  border: 3rpx solid var(--app-accent);
  border-radius: 18rpx 18rpx 18rpx 6rpx;
  box-sizing: border-box;
  position: relative;
  background: transparent;
}

.msg-rail-chat-ico::after {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: -7rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--app-accent);
  border-bottom: 3rpx solid var(--app-accent);
  transform: rotate(-40deg);
  background: #eaf0ff;
  box-sizing: border-box;
}

.msg-rail-item.on .msg-rail-dot {
  outline: 4rpx solid var(--app-accent);
  outline-offset: 4rpx;
}

.msg-rail-dot.brown {
  background: #b86448;
}

.msg-rail-dot.muu {
  background: #2f6df4;
  padding: 0;
}

.msg-rail-dot.green {
  background: #688651;
}

.msg-rail-label {
  display: block;
  max-width: 116rpx;
  font-size: 20rpx;
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.msg-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 28rpx 12rpx;
}

.msg-type-filter {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--app-bg);
  color: var(--app-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.msg-type-filter.active {
  background: var(--app-accent-wash);
  color: var(--app-accent);
}

.msg-tabs {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 40rpx;
  background: transparent;
  min-height: 64rpx;
}

.msg-tab {
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 36rpx;
  color: var(--app-muted);
}

.msg-tab.on {
  color: var(--app-accent);
  font-weight: 600;
  background: rgba(47, 109, 244, 0.08);
}

.msg-sync {
  margin: 8rpx 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--app-bg);
  font-size: 24rpx;
  color: var(--app-muted);
}

.msg-sync.err {
  color: #b91c1c;
  background: #fef2f2;
}

.msg-link {
  margin-left: 12rpx;
  color: var(--app-accent);
}

.msg-actions {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 28rpx;
}

.msg-btn {
  flex: 1;
  font-size: 26rpx;
  background: var(--app-ink);
  color: #fff;
  border-radius: 999rpx;
  padding: 16rpx 0;
}

.msg-btn.ghost {
  background: transparent;
  color: var(--app-ink);
  border: 1rpx solid var(--app-line);
}

.msg-search-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 28rpx 8rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--app-line);
  border-radius: 26rpx;
  background: #fff;
}

.msg-search-field-ico {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.msg-search-field-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  font-size: 26rpx;
  color: var(--app-ink);
}

.msg-input-ph {
  color: var(--app-muted);
  font-size: 26rpx;
  line-height: 72rpx;
}

.msg-note {
  margin: 0 28rpx 12rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.msg-section-title {
  padding: 8rpx 28rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.msg-empty-ai {
  margin: 8rpx 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--app-bg);
  font-size: 24rpx;
  color: var(--app-accent);
  text-align: center;
}

.msg-list {
  padding: 4rpx 0 0;
}

.msg-row {
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 28rpx;
  min-height: 124rpx;
}

.msg-row-hit {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}

.msg-tile {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #697786;
  overflow: hidden;
}

.msg-tile-img {
  width: 100%;
  height: 100%;
  display: block;
}

.msg-tile.ai {
  background: var(--app-accent);
  padding: 16rpx;
  box-sizing: border-box;
}

.msg-tile.ai .msg-tile-img {
  width: 100%;
  height: 100%;
}

.msg-tile.dm {
  background: #4b5563;
}

.msg-tile.ch {
  background: #697786;
}

.msg-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.msg-row-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--app-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.msg-row-time {
  font-size: 22rpx;
  color: var(--app-muted);
  flex-shrink: 0;
}

.msg-row-preview {
  font-size: 24rpx;
  color: var(--app-muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-badge {
  min-width: 36rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--app-accent);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  flex-shrink: 0;
}

.msg-row-more {
  width: 56rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-muted);
  font-size: 36rpx;
  flex-shrink: 0;
  letter-spacing: 2rpx;
}

.msg-invite-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.msg-mini-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--app-ink);
  color: #fff;
  text-align: center;
}

.msg-mini-btn.ghost {
  background: transparent;
  color: var(--app-ink);
  border: 1rpx solid var(--app-line);
}

.msg-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.msg-empty-title {
  font-size: 28rpx;
  color: var(--app-ink);
  margin-bottom: 12rpx;
}

.msg-empty-lead {
  font-size: 24rpx;
  color: var(--app-muted);
}

.msg-link-reset {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--app-accent);
  font-weight: 500;
}

.msg-drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 21, 37, 0.4);
  z-index: 100;
  display: flex;
  justify-content: flex-start;
  flex-direction: row;
}

.msg-drawer-mask.sheet {
  flex-direction: column;
  justify-content: flex-end;
}

.msg-drawer {
  width: 78%;
  max-width: 620rpx;
  height: 100%;
  background: #fff;
  padding: 48rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.msg-drawer-brand {
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.msg-drawer-logo {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.msg-drawer-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--app-ink);
}

.msg-drawer-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.msg-drawer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--app-line);
}

.msg-drawer-item.on {
  background: var(--app-accent-wash);
  margin: 0 -16rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 16rpx;
  border-bottom-color: transparent;
}

.msg-drawer-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.msg-drawer-name {
  font-size: 28rpx;
  font-weight: 550;
  color: var(--app-ink);
}

.msg-drawer-desc {
  font-size: 22rpx;
  color: var(--app-muted);
}

.msg-drawer-count {
  font-size: 24rpx;
  color: var(--app-muted);
  flex-shrink: 0;
}

.msg-drawer-foot {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--app-muted);
}

.msg-drawer-close {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-accent);
  padding: 16rpx;
}

.msg-sheet {
  margin-top: auto;
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.msg-drawer-mask .msg-sheet {
  align-self: flex-end;
}

.msg-sheet-field {
  margin-top: 8rpx;
  padding: 0 24rpx;
  height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid #dcdfea;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.msg-sheet-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  font-size: 30rpx;
  color: var(--app-ink);
}

.msg-sheet-field .msg-input-ph {
  font-size: 30rpx;
  line-height: 88rpx;
}

.msg-sheet-hint {
  margin: 16rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--app-muted);
  line-height: 1.5;
}

.msg-sheet-error {
  margin: 12rpx 0;
  font-size: 24rpx;
  color: #b91c1c;
}

.msg-sheet-actions {
  margin: 24rpx 0 0;
}
