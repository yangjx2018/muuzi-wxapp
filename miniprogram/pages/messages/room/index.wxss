.chat-page {
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fff;
  box-sizing: border-box;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  background: #fff;
}

.chat-header-back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-header-back-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.chat-header-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chat-header-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--app-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-header-sub {
  font-size: 20rpx;
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx 8rpx;
  border-bottom: 1rpx solid var(--app-line);
  background: #fff;
}

.chat-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--app-muted);
}

.chat-tab.on {
  color: var(--app-accent);
  background: var(--app-accent-wash);
  font-weight: 600;
}

.chat-tab-ico {
  font-size: 22rpx;
}

.chat-tab-img {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.55;
}

.chat-tab.on .chat-tab-img {
  opacity: 1;
}

.chat-tab-spacer {
  flex: 1;
}

.chat-more {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-ico-more {
  width: 36rpx;
  height: 8rpx;
  position: relative;
}

.chat-ico-more::before,
.chat-ico-more::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--app-ink);
  top: 0;
}

.chat-ico-more::before {
  left: 0;
  box-shadow: 14rpx 0 0 var(--app-ink), 28rpx 0 0 var(--app-ink);
}

.chat-ico-more::after {
  display: none;
}

.chat-security {
  text-align: center;
  font-size: 22rpx;
  color: var(--app-muted);
  padding: 16rpx 28rpx 4rpx;
}

.chat-security.soft {
  padding-top: 4rpx;
}

.chat-e2ee {
  margin: 8rpx 28rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #92400e;
  background: #fffbeb;
  border-radius: 12rpx;
  border: 1rpx solid #fde68a;
}

.chat-scroll {
  flex: 1;
  height: 0;
  padding: 12rpx 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.chat-older,
.chat-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--app-muted);
  padding: 16rpx 0 20rpx;
}

.chat-sender {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: var(--app-muted);
  margin-bottom: 6rpx;
  max-width: 78%;
}

.chat-sender-time {
  font-size: 18rpx;
  flex-shrink: 0;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.chat-row.own {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #697786;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.chat-avatar.own {
  background: var(--app-ink);
}

.chat-col {
  max-width: calc(100% - 90rpx);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.chat-row.own .chat-col {
  align-items: flex-end;
}

.chat-sender-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: 100%;
  color: var(--app-muted);
  font-size: 20rpx;
}

.chat-sender-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.chat-bubble-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.chat-bubble-wrap.own {
  align-items: flex-end;
}

.chat-bubble {
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: #f0f1f3;
  color: var(--app-ink);
}

.chat-bubble.own {
  background: #d2e3ff;
  color: #20252d;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  border: 0;
}

.chat-bubble.failed {
  opacity: 0.85;
  outline: 2rpx solid #b91c1c;
}

.chat-reply-action {
  font-size: 20rpx;
  color: var(--app-muted);
  padding: 4rpx 0;
}

.chat-reply {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid currentColor;
}

.chat-bubble.own .chat-reply {
  border-left-color: rgba(32, 37, 45, 0.35);
}

.chat-body {
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.chat-image {
  display: block;
  max-width: 420rpx;
  width: 100%;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.06);
}

.chat-bubble.own .chat-image {
  background: rgba(255, 255, 255, 0.12);
}

.chat-video {
  display: block;
  width: 420rpx;
  max-width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: #000;
}

.chat-file {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 220rpx;
  max-width: 420rpx;
}

.chat-file-name {
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.chat-file-hint {
  font-size: 20rpx;
  opacity: 0.7;
}

.chat-image-placeholder {
  font-size: 26rpx;
  opacity: 0.75;
  min-width: 160rpx;
}

.chat-meta {
  margin-top: 8rpx;
  font-size: 18rpx;
  opacity: 0.65;
}

.chat-retry {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b91c1c;
}

.chat-bottom-anchor {
  height: 1rpx;
}

.chat-error {
  padding: 12rpx 28rpx;
  font-size: 22rpx;
  color: #b91c1c;
  background: #fff5f5;
}

.chat-reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 28rpx;
  background: #fff;
  border-top: 1rpx solid var(--app-line);
}

.chat-reply-draft {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: #eef0f2;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.chat-reply-copy {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--app-ink);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chat-reply-snip {
  color: var(--app-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-reply-cancel {
  color: var(--app-muted);
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-ico-close {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  color: var(--app-muted);
}

.chat-ico-close::before,
.chat-ico-close::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 20rpx;
  height: 3rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.chat-ico-close::before {
  transform: rotate(45deg);
}

.chat-ico-close::after {
  transform: rotate(-45deg);
}

.chat-emoji {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 16rpx 16rpx;
  background: #fff;
  border-top: 1rpx solid var(--app-line);
  max-height: 360rpx;
}

.chat-emoji-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
}

.chat-emoji-cat {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: var(--app-muted);
  border-radius: 999rpx;
  background: var(--app-bg);
}

.chat-emoji-cat.on {
  color: var(--app-accent);
  font-weight: 600;
}

.chat-emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  overflow-y: auto;
}

.chat-emoji-item {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
}

.chat-composer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 20rpx calc(8rpx + env(safe-area-inset-bottom));
  background: #f5f6f7;
  border-top: 1rpx solid var(--app-line);
}

.chat-composer.kb-open {
  padding-bottom: 8rpx;
}

.chat-composer.expanded .chat-input {
  min-height: 220rpx;
}

.chat-input-field {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 12rpx 16rpx 20rpx;
}

.chat-input {
  flex: 1;
  min-width: 0;
  min-height: 44rpx;
  max-height: 280rpx;
  padding: 0;
  background: transparent;
  font-size: 30rpx;
  line-height: 1.45;
  width: 100%;
}

.chat-expand {
  width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #747b85;
  flex-shrink: 0;
}

.chat-ico-expand {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
  box-sizing: border-box;
}

.chat-ico-expand::before {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  top: -8rpx;
  right: -8rpx;
}

.chat-ico-expand.on {
  transform: rotate(180deg);
}

.chat-tools {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx;
}

.chat-tool-hit {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #747b85;
}

.chat-tool-hit.send {
  margin-left: auto;
  color: #a7adb4;
}

.chat-tool-hit.send.on {
  color: var(--app-accent);
}

.chat-ico-smile {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}

.chat-ico-smile::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 12rpx 0 0 currentColor;
}

.chat-ico-smile::after {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  height: 10rpx;
  border-bottom: 3rpx solid currentColor;
  border-radius: 0 0 20rpx 20rpx;
  box-sizing: border-box;
}

.chat-ico-plus-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}

.chat-ico-plus-circle::before,
.chat-ico-plus-circle::after {
  content: '';
  position: absolute;
  background: currentColor;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

.chat-ico-plus-circle::before {
  width: 18rpx;
  height: 3rpx;
}

.chat-ico-plus-circle::after {
  width: 3rpx;
  height: 18rpx;
}

/* 对齐 App MessagesScreen Icon name="share"：纸飞机发送 */
.chat-send-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.chat-tool-ico {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #747b85;
}

.chat-send-ico {
  margin-left: auto;
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #a7adb4;
}

.chat-send-ico.on {
  color: var(--app-accent);
}

.chat-attach-menu {
  padding: 12rpx 28rpx 8rpx;
  background: #f5f6f7;
  border-top: 1rpx solid var(--app-line);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.chat-attach-btn {
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  font-size: 24rpx;
  color: var(--app-ink);
}

.chat-attach-hint {
  width: 100%;
  font-size: 20rpx;
  color: var(--app-muted);
}

.chat-settings-btn {
  font-size: 26rpx;
  color: #2563eb;
  padding: 8rpx 0;
  flex-shrink: 0;
}

.chat-settings-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 40;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chat-settings-panel {
  width: 100%;
  max-height: 86vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.chat-settings-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.chat-settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-ink);
}

.chat-settings-close {
  line-height: 1;
  color: var(--app-muted);
  padding: 4rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-settings-note {
  font-size: 22rpx;
  color: var(--app-muted);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.chat-settings-alert {
  font-size: 24rpx;
  color: #b91c1c;
  margin-bottom: 12rpx;
}

.chat-settings-status {
  font-size: 24rpx;
  color: #166534;
  margin-bottom: 12rpx;
}

.chat-settings-body {
  flex: 1;
  max-height: 60vh;
}

.chat-settings-field {
  margin-bottom: 24rpx;
}

.chat-settings-label {
  display: block;
  font-size: 24rpx;
  color: var(--app-muted);
  margin-bottom: 8rpx;
}

.chat-settings-input,
.chat-settings-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--app-line);
  border-radius: 12rpx;
  font-size: 26rpx;
  background: var(--app-bg);
  margin-bottom: 12rpx;
}

.chat-settings-textarea {
  min-height: 140rpx;
}

.chat-settings-h3 {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
  color: var(--app-ink);
}

.chat-settings-member {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--app-line);
}

.chat-settings-member-info {
  flex: 1;
  min-width: 0;
}

.chat-settings-member-name {
  font-size: 26rpx;
  font-weight: 550;
  color: var(--app-ink);
}

.chat-settings-member-tag {
  font-size: 20rpx;
  color: #92400e;
  margin-top: 4rpx;
}

.chat-settings-member-id {
  font-size: 20rpx;
  color: var(--app-muted);
  margin-top: 4rpx;
  word-break: break-all;
}

.chat-settings-btn-ghost,
.chat-settings-btn-danger,
.chat-settings-btn-primary {
  font-size: 24rpx !important;
  margin: 0 !important;
  padding: 0 16rpx !important;
  line-height: 56rpx !important;
  background: transparent !important;
  color: #2563eb !important;
  border: 1rpx solid var(--app-line) !important;
  border-radius: 12rpx !important;
}

.chat-settings-btn-danger {
  color: #b91c1c !important;
  border-color: #fecaca !important;
}

.chat-settings-btn-primary {
  color: #fff !important;
  background: var(--app-accent, #2f6df4) !important;
  border-color: var(--app-accent, #2f6df4) !important;
  margin-top: 8rpx !important;
}

.chat-contact {
  margin: 8rpx 0 24rpx;
  padding: 20rpx;
  border: 2rpx solid #e6e8ed;
  border-radius: 20rpx;
  font-size: 26rpx;
  text-align: left;
  box-sizing: border-box;
}

.chat-contact-summary {
  font-size: 28rpx;
  color: var(--app-ink);
  padding: 4rpx 0;
}

.chat-contact-dl {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.chat-contact-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.chat-contact-dt {
  flex: 0 0 140rpx;
  color: var(--app-muted);
  line-height: 1.5;
}

.chat-contact-dd {
  flex: 1;
  min-width: 0;
  color: var(--app-ink);
  line-height: 1.5;
  word-break: break-all;
}

.chat-contact-server {
  display: block;
  margin-top: 4rpx;
  color: var(--app-muted);
  font-size: 24rpx;
}

.chat-contact-account-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.chat-contact-account {
  flex: 1;
  min-width: 0;
}

.chat-contact-copy {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: var(--app-accent, #2f6df4);
  background: rgba(47, 109, 244, 0.1);
  font-size: 28rpx;
}

.chat-contact-copy-notice,
.chat-contact-notice {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #166534;
  line-height: 1.5;
}

.chat-contact-copy-notice.fail,
.chat-contact-notice.fail {
  color: #b91c1c;
}

.chat-contact-form {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chat-contact-form .chat-settings-btn-ghost,
.chat-contact-form .chat-settings-btn-primary {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.chat-contact-hint {
  margin: 4rpx 0;
  font-size: 22rpx;
  color: #687184;
  line-height: 1.5;
}

.chat-settings-confirm {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--app-line);
}

.chat-settings-confirm-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.chat-settings-confirm-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
